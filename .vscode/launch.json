{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "XDebug",
      "type": "php",
      "request": "launch",
      "port": 9000,
      "pathMappings": {
        "/var/www/camac": "${workspaceRoot}/php"
      }
    },
    {
      "name": "Django",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": "${input:djangoDebugPort}"
      },
      "justMyCode": false,
      "django": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/django",
          "remoteRoot": "."
        }
      ]
    },
    {
      "name": "BE Portal (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/ember-caluma-portal",
      "sourceMapPathOverrides": {
        "ember-caluma-portal/*": "${workspaceFolder}/ember-caluma-portal/app/*"
      }
    },
    {
      "name": "Ember Camac NG (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4300",
      "webRoot": "${workspaceFolder}/ember-camac-ng",
      "sourceMapPathOverrides": {
        "camac-ng/*": "${workspaceFolder}/ember-camac-ng/app/*"
      }
    }
  ],
  "inputs": [
    {
      "id": "djangoDebugPort",
      "type": "pickString",
      "description": "Which process to attach to?",
      "default": "5678",
      "options": [
        { "label": "API", "value": "5678" },
        { "label": "Celery (default queue)", "value": "5679" },
        { "label": "Celery (import queue)", "value": "5680" },
        { "label": "Celery (tika queue)", "value": "5681" }
      ]
    }
  ]
}

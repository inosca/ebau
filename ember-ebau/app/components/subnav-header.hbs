<div class="subnav-header">
  <div class="uk-flex uk-flex-between">
    <span class="uk-text-bold">{{@case.dossierNumber}}</span>
    <div>
      {{#if @case.dossierNumber}}
        <UkButton
          @color="link"
          @onClick={{fn this.copyLink @case.dossierNumber}}
          {{uk-tooltip (t "cases.copy.title")}}
        >
          <UkIcon @icon="copy" />
        </UkButton>
      {{/if}}
      {{#if
        (and
          (has-feature "instanceMarks")
          (has-all-permissions @case.instanceId "instance-mark-write")
        )
      }}
        <UkButton
          @color="link"
          @onClick={{this.toggleEditMode}}
          {{uk-tooltip
            (t
              (concat
                "cases.instanceMarks.editor." (if this.editMode "save" "edit")
              )
            )
          }}
        >
          <UkIcon @icon={{if this.editMode "check" "pencil"}} />
        </UkButton>
      {{/if}}
    </div>
  </div>
  {{this.name}}
  <InstanceMarks::Editor
    @editMode={{this.editMode}}
    @selectedMarks={{if
      this.editMode
      this.selectedMarks
      @case.instance.instanceMarks
    }}
    @onToggle={{this.toggleMark}}
    @onChange={{fn (mut this.selectedMarks)}}
  />
  <div>
    {{#if (await (can "access instance on level read for instance"))}}
      <span
        class="uk-label subnav-header__label subnav-header__label--primary subnav-header__label--read-only"
      >{{t "nav.hasOnlyReadPermission"}}</span>
    {{/if}}
    {{#if @case.instanceState}}
      <span
        class="uk-label subnav-header__label subnav-header__label--primary"
      >{{@case.instanceState}}</span>
    {{/if}}
    {{#if @case.decision}}
      <span
        class="uk-label subnav-header__label subnav-header__label--secondary"
      >{{@case.decision}}</span>
    {{/if}}
    {{#if @case.instance.isSuspended}}
      <span class="uk-label subnav-header__label">{{t "nav.suspended"}}</span>
    {{/if}}
    {{#if @case.instance.isPaper}}
      <span class="uk-label subnav-header__label">{{t "nav.paper"}}</span>
    {{/if}}
    {{#if @case.meta.is-bab}}
      <span class="uk-label subnav-header__label">{{t "nav.bab"}}</span>
    {{else if @case.isBib}}
      <span class="uk-label subnav-header__label">{{t "nav.bib"}}</span>
    {{/if}}
    {{#if @case.instance.isModification}}
      <span class="uk-label subnav-header__label">{{t
          "nav.modification"
        }}</span>
    {{/if}}
    {{#if @case.meta.is-appeal}}
      <span class="uk-label subnav-header__label">{{t "nav.appeal"}}</span>
    {{/if}}
    {{#if @case.instance.additionalDemandChanges}}
      <span class="uk-label subnav-header__label">
        {{t "nav.additionalDemandChanges"}}
      </span>
    {{/if}}
  </div>
</div>
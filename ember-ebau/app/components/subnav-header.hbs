<div class="subnav-header">
  <span class="uk-text-bold">{{@case.dossierNumber}}</span>
  {{#if @case.dossierNumber}}
    <UkButton
      @color="link"
      @title={{t "cases.copy.title"}}
      @onClick={{fn this.copyLink @case.dossierNumber}}
    >
      <UkIcon @icon="copy" />
    </UkButton>
  {{/if}}
  <br />
  {{this.name}}
  <div>
    {{#if @case.instanceState}}
      <span
        class="uk-label subnav-header__label subnav-header__label--primary"
      >{{@case.instanceState}}</span>
    {{/if}}
    {{#if @case.decision}}
      <span
        class="uk-label subnav-header__label subnav-header__label--secondary"
      >{{@case.decision}}</span>
    {{/if}}
    {{#if @case.instance.isSuspended}}
      <span class="uk-label subnav-header__label">{{t "nav.suspended"}}</span>
    {{/if}}
    {{#if @case.instance.isPaper}}
      <span class="uk-label subnav-header__label">{{t "nav.paper"}}</span>
    {{/if}}
    {{#if @case.meta.is-bab}}
      <span class="uk-label subnav-header__label">{{t "nav.bab"}}</span>
    {{else if @case.isBib}}
      <span class="uk-label subnav-header__label">{{t "nav.bib"}}</span>
    {{/if}}
    {{#if @case.instance.isModification}}
      <span class="uk-label subnav-header__label">{{t
          "nav.modification"
        }}</span>
    {{/if}}
    {{#if @case.meta.is-appeal}}
      <span class="uk-label subnav-header__label">{{t "nav.appeal"}}</span>
    {{/if}}
  </div>
</div>
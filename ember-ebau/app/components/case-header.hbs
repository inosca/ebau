<div
  class="master-data-header {{if (or @fullscreen this.compact) 'compact'}}"
  ...attributes
>
  {{#if
    (and
      (has-feature "cases.showNoApplicantRegisteredWarning")
      this.showNoApplicantRegisteredWarningForInstance
    )
  }}
    <div
      class="uk-alert-warning"
      uk-alert
      {{uk-tooltip
        (t "cases.header.noApplicantRegisteredWarningTooltip")
        animation="uk-animation-fade"
      }}
    >
      <p>{{t "cases.header.noApplicantRegisteredWarning"}}</p>
    </div>
  {{/if}}
  <div
    class="uk-child-width-1-3@s uk-child-width-1-4@m uk-child-width-1-6@l uk-grid-small"
    uk-grid
  >
    <div>
      <div class="uk-text-bold">{{t "cases.tableHeaders.address"}}</div>
      {{or @case.address "-"}}
    </div>
    <div class={{if (or @fullscreen this.compact) "uk-text-truncate"}}>
      <div class="uk-text-bold">{{t "cases.tableHeaders.intent"}}</div>
      <TruncatedText @content={{this.intent}} />
    </div>
    <div>
      <div class="uk-text-bold">{{t "cases.tableHeaders.applicants"}}</div>
      {{or @case.applicants "-"}}
    </div>
    <div>
      <div class="uk-text-bold">{{t "cases.tableHeaders.municipality"}}</div>
      {{or @case.municipality "-"}}
    </div>
    <div>
      <div class="uk-text-bold">
        {{t "cases.tableHeaders.submitDate"}}
        {{#if
          (and (has-feature "deadlines.enabled") (await (can "read deadline")))
        }}
          /
          {{#if (has-feature "deadlines.useEndDate")}}
            {{t
              (if
                @case.deadline.processDeadlineDate
                "cases.tableHeaders.processDeadlineDate"
                "cases.tableHeaders.deadlineEndDate"
              )
            }}
          {{else}}
            {{t "cases.tableHeaders.processDuration"}}
          {{/if}}
        {{/if}}
      </div>
      {{or @case.submitDate "-"}}

      {{#if
        (and (has-feature "deadlines.enabled") (await (can "read deadline")))
      }}
        /
        <LinkTo @route={{module-route "deadlines" "index"}}>
          {{#if (has-feature "deadlines.useEndDate")}}
            {{#let
              (if
                @case.deadline.processDeadlineDate
                @case.deadline.processDeadlineDate
                @case.deadline.targetDeadlineDate
              )
              as |deadlineDate|
            }}
              {{#if @case.deadline.instance.isSuspended}}
                <s>
                  {{if
                    deadlineDate
                    (format-date deadlineDate format="date")
                    (t "deadlines.deadline.noEndDate")
                  }}
                </s>
              {{else}}
                {{if
                  deadlineDate
                  (format-date deadlineDate format="date")
                  (t "deadlines.deadline.noEndDate")
                }}
              {{/if}}
            {{/let}}
          {{else}}
            {{#if @case.deadline.instance.isSuspended}}
              <s>
                {{t
                  "deadlines.deadline.processDurationText"
                  count=(or @case.deadline.processDeadlineDays 0)
                }}
              </s>
            {{else}}
              {{t
                "deadlines.deadline.processDurationText"
                count=(or @case.deadline.processDeadlineDays 0)
              }}
            {{/if}}
          {{/if}}
        </LinkTo>
      {{/if}}
    </div>
    <div>
      <div class="uk-text-bold">{{t "cases.tableHeaders.parcel"}}</div>
      {{or @case.plots "-"}}
      {{#if @case.coordinatesLink}}(<a
          href={{@case.coordinatesLink}}
          target="_blank"
          rel="noopener noreferrer"
        >{{format-coordinate @case.centerCoordinate}}</a>){{/if}}
    </div>
    {{#if this.extended}}
      <div>
        <div class="uk-text-bold">{{t
            "cases.tableHeaders.responsibility"
          }}</div>
        {{or @case.responsible.fullName "-"}}
      </div>
      <div>
        <div class="uk-text-bold">{{t "cases.header.printPreview"}}</div>
        <a href="#" {{on "click" (perform this.downloadPdf)}}>
          {{#if this.downloadPdf.isRunning}}
            <UkSpinner @ratio="0.6" />
          {{else}}
            <UkIcon @icon="file-pdf" />
          {{/if}}
          {{t "cases.header.form"}}
        </a>
      </div>
      <div class="uk-flex uk-flex-column">
        <div class="uk-text-bold">{{t
            "cases.tableHeaders.linkedInstances"
          }}</div>
        <LinkedInstancesCounter @case={{@case}} />
      </div>
      {{#if this.evenProjectnumbers}}
        <div>
          <div class="uk-text-bold">{{t "cases.tableHeaders.even"}}</div>
          <EvenProjectnumberList @value={{this.evenProjectnumbers}} />
        </div>
      {{/if}}
      <div class="{{this.keywordsCssClass}} uk-flex">
        <div class={{if this.showStaticKeywords "uk-width-1-2" "uk-width-1"}}>
          <div class="uk-text-bold">{{t "cases.header.keywords"}}</div>
          {{#if @case.instance}}
            <CaseHeader::Keywords @instance={{@case.instance}} />
          {{else}}
            -
          {{/if}}
        </div>
        {{#if this.showStaticKeywords}}
          <div class="uk-width-1-2 uk-margin-left">
            <div class="uk-text-bold">{{t "cases.header.static-keywords"}}</div>
            {{#if @case.instance}}
              <CaseHeader::StaticKeywords @instance={{@case.instance}} />
            {{else}}
              -
            {{/if}}
          </div>
        {{/if}}
      </div>
    {{/if}}
  </div>
</div>

<div class="master-data-divider {{unless @fullscreen 'uk-margin-bottom'}}">
  <button
    type="button"
    disabled={{@fullscreen}}
    class="master-data-divider__toggle uk-button uk-button-link uk-margin-right"
    {{on "click" this.toggleHeader}}
    {{uk-tooltip
      (t this.toggleButtonTooltip)
      pos="right"
      animation="uk-animation-fade"
    }}
  >
    {{t "nav.masterData.label"}}
    <UkIcon @icon={{if this.compact "eye" "eye-slash"}} />
  </button>
</div>
<h1 class="uk-text-center">
  {{t "case.new.title"}}
</h1>

{{#if this.sections}}
  {{#each this.sections as |section|}}
    <div class="uk-margin-top">
      <h3>{{t (concat "case.new.sections." section.name)}}</h3>

      <div
        uk-grid
        class="uk-grid uk-grid-small uk-child-width-1-1 uk-child-width-1-{{this.maxGroupsInSections}}@s uk-margin-bottom uk-margin-small-top"
      >
        {{#each section.groups as |category|}}
          <div class="uk-text-center">
            {{#if (not-eq category.name this.noCategoryStr)}}
              <p class="uk-flex-inline uk-flex-middle">
                {{t (concat "case.new.categories." category.name ".title")}}
              </p>
            {{/if}}
            {{#each category.forms as |form|}}
              <UkButton
                @width="1-1"
                @label={{form.name}}
                @color={{if
                  (eq form.slug this.selectedForm.slug)
                  "secondary"
                  "default"
                }}
                @onClick={{fn (mut this.selectedForm) form}}
                class="uk-margin-small-bottom"
                disabled={{and
                  this.convertFrom
                  (not-eq form.meta.category "building-permit")
                }}
              />
            {{/each}}
          </div>
        {{/each}}
      </div>
    </div>
  {{/each}}
{{/if}}

<div class="uk-text-right">
  {{#if this.selectedForm.meta.onCreatePopup}}
    <UkButton
      @color="primary"
      @label={{t "global.continue"}}
      @onClick={{fn (mut this.showInfoPopup) true}}
    />
  {{else}}
    <UkButton
      @color="primary"
      @label={{t "global.continue"}}
      @disabled={{or (not this.selectedForm) this.save.isRunning}}
      @loading={{this.save.isRunning}}
      @onClick={{perform this.save}}
    />
  {{/if}}
</div>
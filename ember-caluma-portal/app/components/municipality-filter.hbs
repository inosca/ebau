<div>
  <label class="uk-form-label uk-text-center">{{@label}}</label>
  <div class="uk-form-controls">
    <PowerSelect
      class="uk-margin-bottom"
      @selected={{this.selectedMunicipality}}
      @noMatchesMessage={{t "global.noMatch"}}
      @options={{this.municipalities}}
      @searchEnabled={{true}}
      @searchField="label"
      @allowClear={{true}}
      @onChange={{@onChange}}
      aria-label={{@label}}
      as |option|
    >
      {{option.label}}
    </PowerSelect>
  </div>
</div>
{{#unless this.editController.isLoading}}
  <LoadingOrNotfound
    @loading={{this.case.isLoading}}
    @hasPermission={{await
      (can
        "read form of instance"
        this.editController.instance
        form=this.document.form
      )
    }}
  >
    <CfContent
      @documentId={{decode-id this.document.id}}
      @disabled={{await
        (cannot
          "write form of instance"
          this.editController.instance
          form=this.document.form
        )
      }}
      @useAsHeading={{true}}
      @headingBaseLevel={{2}}
      @context={{hash
        instanceId=this.editController.model
        additionalDemandChanges=this.additionalDemandChanges
      }}
      @navigationWidth={{this.navigationWidth}}
      class={{if (is-embedded) "embedded-content"}}
    />
  </LoadingOrNotfound>
{{/unless}}
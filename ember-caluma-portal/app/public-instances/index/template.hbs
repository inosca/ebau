<h1>{{t "publicInstances.title"}}</h1>

{{t "publicInstances.info" htmlSafe=true}}

{{#let (maybe-translate "publicInstances.intro") as |introText|}}
  {{#if introText}}
    <p class="uk-margin-bottom">
      {{introText}}
    </p>
  {{/if}}
{{/let}}

<div class="uk-width-1-4">
  <MunicipalityFilter
    @onChange={{this.updateMunicipality}}
    @selected={{this.municipality}}
    @label={{t "instances.municipality"}}
  />
</div>
<table class="uk-table uk-table-striped uk-table-hover uk-table-responsive">
  <thead>
    <tr>
      <th class="uk-text-nowrap">{{t "instances.special-id"}}</th>
      <th class="uk-text-nowrap">{{t "instances.municipality"}}</th>
      <th class="uk-text-nowrap">{{t "publicInstances.applicant"}}</th>
      <th class="uk-text-nowrap">{{t "instances.description"}}</th>
      <th class="uk-text-nowrap">{{t "instances.address"}}</th>
      <th class="uk-text-nowrap">{{t "instances.parcel"}}</th>
      {{#if (has-feature "publication.endDate")}}
        <th class="uk-text-nowrap">{{t "instances.objectionPeriod"}}</th>
      {{/if}}
    </tr>
  </thead>
  <tbody>
    {{#unless this.instances.isResetting}}
      {{#each this.instances.records as |publicInstance|}}
        <tr>
          <td>
            <LinkTo
              class="uk-text-bold"
              @route="public-instances.detail"
              @model={{publicInstance.instanceId}}
            >
              {{publicInstance.dossierNr}}
            </LinkTo>
          </td>
          <td>{{publicInstance.municipality}}</td>
          <td>{{publicInstance.applicant}}</td>
          <td>{{publicInstance.intent}}</td>
          <td>{{publicInstance.street}}</td>
          <td>{{publicInstance.parcels}}</td>
          {{#if (has-feature "publication.endDate")}}
            <td>{{format-date
                publicInstance.publicationEndDate
                format="date"
              }}</td>
          {{/if}}
        </tr>
      {{else}}
        <tr class="border-bottom-remove">
          <td colspan="6" class="uk-background-default">
            {{#let
              (maybe-translate "publicInstances.empty-title")
              as |emptyTitle|
            }}
              <UkFlex
                @horizontal="center"
                @vertical="middle"
                @direction="column"
              >
                <div class="uk-text-center uk-width-large">
                  <object
                    data="/assets/images/stamp-document.svg"
                    class="uk-width-medium"
                    aria-label={{t "global.stampIcon"}}
                  >
                    {{emptyTitle}}
                  </object>
                  <div class="uk-margin-remove-top">
                    {{#if emptyTitle}}
                      <p class="uk-text-large">{{emptyTitle}}</p>
                    {{/if}}
                    {{#let
                      (maybe-translate "publicInstances.emptyText")
                      as |emptyText|
                    }}
                      <p>{{emptyText}}</p>
                    {{/let}}
                  </div>
                </div>
              </UkFlex>
            {{/let}}
          </td>
        </tr>
      {{/each}}
    {{/unless}}
    {{#if this.instances.isLoading}}
      <tr>
        <td colspan="6" class="uk-text-center">
          <UkSpinner @ratio="0.7" />
        </td>
      </tr>
    {{else if this.instances.hasMore}}
      <tr {{in-viewport onEnter=this.fetchMore viewportSpy=true}}></tr>
    {{/if}}
  </tbody>
</table>
<this.originalLabel @field={{@field}} />

{{#if this.gisChanges}}
  <span class="gis-changes__trigger">
    <UkIcon @icon="warning" @ratio="0.8" />
    &nbsp;
    {{t "gis.changes.title"}}
  </span>
  <div uk-dropdown class="gis-changes__dropdown">
    {{#if this.gisChanges.old}}
      <span
        class="gis-changes__dropdown__diff gis-changes__dropdown__diff--old"
      >
        {{this.gisChanges.old}}
      </span>
    {{/if}}
    {{#if this.gisChanges.new}}
      <span
        class="gis-changes__dropdown__diff gis-changes__dropdown__diff--new"
      >
        {{this.gisChanges.new}}
      </span>
    {{/if}}
  </div>
{{/if}}

{{#if this.gisLink}}
  <a
    class="uk-text-small uk-margin-small-left"
    target="_blank"
    rel="noopener noreferrer"
    href={{this.gisLink}}
  >
    {{t "gis.gis-portal"}}
  </a>
{{/if}}
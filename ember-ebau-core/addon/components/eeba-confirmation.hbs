<CfField::Input::Hidden @field={{@field}} @context={{@context}} />

{{#if this.showRecheck}}
  <p data-test-eeba-recheck>{{t "eeba.integration.re_check"}}</p>
{{/if}}

<UkButton
  @type="button"
  @loading={{this.checkIntegration.isRunning}}
  @disabled={{or
    this.checkIntegration.isRunning
    (not this.canCheckIntegration)
  }}
  @label={{t "eeba.integration.check"}}
  @onClick={{this.checkIntegration.perform}}
  @color="default"
  data-test-eeba-check
/>

{{#if this.hasEebaRequiredAnswer}}
  {{#let
    (maybe-translate
      (concat
        "eeba.integration.description."
        (if this.eebaRequiredAnswer "required" "not_required")
      )
      htmlSafe=true
    )
    as |eebaDescription|
  }}
    {{#if eebaDescription}}
      <p data-test-eeba-description>{{eebaDescription}}</p>
    {{/if}}
  {{/let}}
{{/if}}

<p data-test-eeba-status>
  {{t "eeba.integration.status_eeba"}}:
  <span class={{this.eebaStateClass}}>
    <UkIcon @icon="info" />
  </span>
  {{#let
    (maybe-translate
      (concat "eeba.integration.status." this.eebaStateAnswer) htmlSafe=true
    )
    as |eebaStatus|
  }}
    {{#if eebaStatus}}
      <strong>{{eebaStatus}}</strong>
    {{/if}}
  {{/let}}
</p>

{{#if this.eebaWebUrlAnswer}}
  <a
    target="_blank"
    href={{this.eebaWebUrlAnswer}}
    rel="noopener noreferrer"
    class="uk-button uk-button-default"
    data-test-eeba-web-url
  >{{t "eeba.integration.open"}}</a>
{{/if}}
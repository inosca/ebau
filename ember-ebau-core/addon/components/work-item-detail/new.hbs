<h2>{{t "workItems.new"}}</h2>

{{#if this.workItemTemplates.records.length}}
  <form class="uk-form-stacked" aria-label={{t "workItems.templates.select"}}>
    <label class="uk-form-label">{{t "workItems.templates.info"}}</label>
    <div class="uk-grid-small" uk-grid>
      <div class="uk-width-expand uk-form-controls">
        <PowerSelect
          @searchEnabled={{true}}
          @searchField="name"
          @allowClear={{true}}
          @options={{this.workItemTemplates.records}}
          @selected={{this.selectedTemplate}}
          @placeholder={{t "workItems.templates.select"}}
          @onChange={{fn (mut this.selectedTemplate)}}
          class="uk-select"
          as |template|
        >
          {{template.name}}
        </PowerSelect>
      </div>

      <div>
        <UkButton
          @label={{t "workItems.templates.apply"}}
          @onClick={{this.applyTemplate}}
          @disabled={{not this.selectedTemplate}}
        />
      </div>
    </div>
  </form>

  <div class="uk-margin-top uk-margin-bottom master-data-divider" />
{{/if}}

<form class="uk-form-stacked" {{on "submit" (perform this.createWorkItem)}}>
  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold">
      {{t "workItems.responsible"}}
      <span class="mandatory-asterisk">*</span>
    </label>
    <div class="uk-form-controls">
      <PowerSelect
        @required={{true}}
        @searchEnabled={{true}}
        @searchField="name"
        @renderInPlace={{true}}
        @options={{this.services}}
        @selected={{this.responsibleService}}
        @noMatchesMessage={{t "global.noMatch"}}
        @onChange={{fn (mut this.responsibleService)}}
        as |service|
      >
        {{service.name}}
      </PowerSelect>
    </div>
  </div>

  {{#if this.selectedOwnService}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold">
        {{t "workItems.assignedUser"}}
      </label>
      <div class="uk-form-controls">
        <PowerSelect
          @searchEnabled={{true}}
          @searchField="fullName"
          @renderInPlace={{true}}
          @options={{this.users.records}}
          @selected={{this.responsibleUser}}
          @noMatchesMessage={{t "global.noMatch"}}
          @onChange={{fn (mut this.responsibleUser)}}
          as |user|
        >
          {{user.fullName}}
        </PowerSelect>
      </div>
    </div>
  {{/if}}

  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold">
      {{t "workItems.title"}}
      <span class="mandatory-asterisk">*</span>
    </label>
    <div class="uk-form-controls">
      <Input
        @type="text"
        @value={{mut this.workItem.title}}
        name="title"
        id="title"
        required={{true}}
        class="uk-input"
      />
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold">
      {{t "workItems.description"}}
    </label>
    <div class="uk-form-controls">
      <Textarea
        @value={{this.workItem.description}}
        name="description"
        id="description"
        class="uk-textarea"
        {{autoresize mode="height"}}
      />
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold">
      {{t "workItems.deadline"}}
      <span class="mandatory-asterisk">*</span>
    </label>
    <div class="uk-form-controls">
      <Datepicker
        id="deadline"
        required={{true}}
        @value={{this.workItem.deadline}}
        @onChange={{fn (mut this.workItem.deadline)}}
      />
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold">
      {{t "workItems.notifications"}}
    </label>
    <div class="uk-form-controls">
      <label>
        <Input
          @type="checkbox"
          @checked={{this.workItem.notificationCompleted}}
          class="uk-checkbox"
        />
        {{t "workItems.notifyCompleted"}}
      </label>
      <br />
      <label>
        <Input
          @type="checkbox"
          @checked={{this.workItem.notificationDeadline}}
          class="uk-checkbox"
        />
        {{t "workItems.notifyDeadline"}}
      </label>
    </div>
  </div>

  <div>
    <LinkTo
      @route={{concat @baseRoute ".index"}}
      class="uk-button uk-button-default"
    >
      {{t "global.cancel"}}
    </LinkTo>

    <button class="uk-button uk-button-primary" type="submit">
      {{t "global.save"}}
    </button>
  </div>
</form>
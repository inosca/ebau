<h2>{{t "workItems.new"}}</h2>

{{#if this.workItemTemplates.records.length}}
  <form class="uk-form-stacked" aria-label={{t "workItems.templates.select"}}>
    <label class="uk-form-label">{{t "workItems.templates.info"}}</label>
    <div class="uk-grid-small" uk-grid>
      <div class="uk-width-expand uk-form-controls">
        <PowerSelect
          @searchEnabled={{true}}
          @searchField="name"
          @allowClear={{true}}
          @options={{this.workItemTemplates.records}}
          @selected={{this.selectedTemplate}}
          @placeholder={{t "workItems.templates.select"}}
          @onChange={{fn (mut this.selectedTemplate)}}
          class="uk-select"
          as |template|
        >
          {{template.name}}
        </PowerSelect>
      </div>

      <div>
        <UkButton
          @label={{t "workItems.templates.apply"}}
          @onClick={{this.applyTemplate}}
          @disabled={{not this.selectedTemplate}}
        />
      </div>
    </div>
  </form>

  <hr />
{{/if}}

<ValidatedForm
  @model={{this.model}}
  @on-submit={{this.createWorkItem.perform}}
  class="uk-form-stacked"
  as |f|
>
  <div class="uk-margin">
    <f.input
      @label={{t "workItems.responsible"}}
      @name="addressedService"
      @required={{true}}
      as |fi|
    >
      <div class="uk-form-controls">
        <PowerSelect
          @required={{true}}
          @searchEnabled={{true}}
          @searchField="name"
          @renderInPlace={{true}}
          @options={{this.services}}
          @selected={{fi.value}}
          @noMatchesMessage={{t "global.noMatch"}}
          @onChange={{fi.update}}
          @onClose={{fi.setDirty}}
          class="uk-select {{this.getValidationClass fi}}"
          as |service|
        >
          {{service.name}}
        </PowerSelect>
      </div>
    </f.input>
  </div>

  {{#if this.selectedOwnService}}
    <div class="uk-margin">
      <f.input
        @label={{t "workItems.assignedUser"}}
        @name="assignedUser"
        as |fi|
      >
        <div class="uk-form-controls">
          <PowerSelect
            @searchEnabled={{true}}
            @searchField="fullName"
            @renderInPlace={{true}}
            @options={{this.users.records}}
            @selected={{fi.value}}
            @noMatchesMessage={{t "global.noMatch"}}
            @onChange={{fi.update}}
            @onClose={{fi.setDirty}}
            class="uk-select {{this.getValidationClass fi}}"
            as |user|
          >
            {{user.fullName}}
          </PowerSelect>
        </div>
      </f.input>
    </div>
  {{/if}}

  <f.input @label={{t "workItems.title"}} @name="title" @required={{true}} />

  <f.input @name="description" @label={{t "workItems.description"}} as |fi|>
    <Snippets
      @disabled={{or
        (not this.showSnippets)
        (not (has-feature "workItems.snippets"))
      }}
    >
      <textarea
        class="uk-textarea uk-input"
        name="description"
        id="f-description"
        value={{fi.value}}
        {{on "input" (fn this.updateDescription fi)}}
        {{autoresize mode="height"}}
      />
    </Snippets>
  </f.input>
  <div class="uk-margin">
    <f.input
      @label={{t "workItems.deadline"}}
      @name="deadline"
      @required={{true}}
      as |fi|
    >
      <Datepicker
        id="deadline"
        @value={{fi.value}}
        @onChange={{fi.update}}
        class={{this.getValidationClass fi}}
      />
    </f.input>
  </div>

  <f.input
    @type="checkboxGroup"
    @label={{t "workItems.notifications"}}
    @name="notifications"
    @options={{this.notificationOptions}}
  />

  <LinkTo
    @route={{concat @baseRoute ".index"}}
    class="uk-button uk-button-default"
  >
    {{t "global.cancel"}}
  </LinkTo>

  <f.submit
    @label={{t "global.save"}}
    @disabled={{f.loading}}
    @loading={{f.loading}}
  />
</ValidatedForm>
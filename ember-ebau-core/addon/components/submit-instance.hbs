<DocumentValidityButton
  @field={{@field}}
  @context={{@context}}
  @buttonHintText={{this.buttonHintText}}
  @validateOnEnter={{true}}
  @showLoadingHint={{true}}
  @buttonLabel={{this.buttonLabel}}
  @afterValidate={{this.submit.perform}}
  @validateWhileDisabled={{not @disabled}}
  @disabled={{or this.cannotSubmit.isLoading this.cannotSubmit.value}}
/>
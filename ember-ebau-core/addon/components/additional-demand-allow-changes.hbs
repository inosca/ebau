{{#if (await (can "request applicant correction on additional-demand"))}}
  <CfField::Input::Checkbox
    @field={{@field}}
    @disabled={{@disabled}}
    @context={{@context}}
    @onSave={{@onSave}}
  />

  {{#if
    (and
      (maybe-translate "additional-demand.allow-changes-hint")
      (not @disabled)
      @field.value
    )
  }}
    <div class="uk-alert border-highlight">
      {{t "additional-demand.allow-changes-hint" htmlSafe=true}}
    </div>
  {{/if}}
{{/if}}
{{#if (await (can "add journal-entry"))}}
  {{#if this.newEntry.edit}}
    <JournalTextarea
      @journalEntry={{this.newEntry}}
      @onSaveNewJournalEntry={{this.refetchEntries}}
      @showJournalEntryDuration={{this.showJournalEntryDuration}}
    />
  {{else}}
    <div class="uk-flex uk-flex-between">
      <UkButton
        @type="button"
        @color="primary"
        @onClick={{perform this.initializeNewEntry}}
        data-test-create
      >
        {{t "journal.create"}}
      </UkButton>
      {{#if this.showJournalEntryDuration}}
        <div
          class="uk-flex uk-flex-middle uk-margin-small-right"
          {{uk-tooltip (t "journal.totalDuration")}}
        >
          <span class="uk-icon" uk-icon="icon: future; ratio:0.9" />
          <span
            class="uk-text-large inline-icon-margin"
          >{{this.journalTotalDuration}}</span>
        </div>
      {{/if}}
    </div>
  {{/if}}
  <hr />
{{/if}}

<div class="uk-margin" data-test-journal-list>
  {{#if this.entries.isLoading}}
    <div class="uk-text-center"><UkSpinner @ratio={{2}} /></div>
  {{else if this.entries.records.length}}
    {{#each this.entries.records as |entry|}}
      <JournalEntry
        @journalEntry={{entry}}
        @onSaveNewJournalEntry={{this.refetchEntries}}
        @showJournalEntryDuration={{this.showJournalEntryDuration}}
      />
    {{/each}}
  {{else}}
    {{t "global.empty"}}
  {{/if}}
</div>
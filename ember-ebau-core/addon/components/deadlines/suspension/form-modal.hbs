<UkModal
  @visible={{@visible}}
  @onHide={{@onHide}}
  @dialogClass="deadlines-module-create-suspension-modal-dialog"
  data-test-modal-create-suspension
  as |modal|
>
  <modal.header>
    <h2 class="uk-modal-title uk-margin-right">{{t
        "deadlines.action.suspension.create"
      }}</h2>
  </modal.header>
  <ValidatedForm
    @model={{changeset this.formData this.validations}}
    @on-submit={{perform this.saveSuspension}}
    class="uk-form-stacked"
    as |f|
  >
    <modal.body>
      <f.input
        @label={{t "deadlines.suspension.property.startDate"}}
        @name="startDate"
        @errorComponent={{component "input-error"}}
        as |fi|
      >
        <div data-test-suspension-start-date-input>
          <Datepicker
            @value={{fi.value}}
            @maxDate={{this.today}}
            @onChange={{fi.update}}
            @defaultHour={{0}}
          />
        </div>
      </f.input>
      <f.input
        @label={{t "deadlines.suspension.property.endDate"}}
        @name="endDate"
        @errorComponent={{component "input-error"}}
        as |fi|
      >
        <div data-test-suspension-end-date-input>
          <Datepicker
            @value={{fi.value}}
            @minDate={{or f.model.startDate}}
            @maxDate={{this.today}}
            @onChange={{fi.update}}
          />
        </div>
      </f.input>
      {{#if (has-feature "deadlines.manualSuspensionReason")}}
        <f.input
          @name="reason"
          @label={{t "deadlines.suspension.property.reason"}}
          @required={{true}}
          @errorComponent={{component "input-error"}}
          as |fi|
        >
          <PowerSelect
            @triggerId="reason"
            data-test-suspension-reason-input
            @selected={{fi.value}}
            @placeholder={{t "deadlines.suspension.property.reason"}}
            @options={{@suspensionReasons}}
            @onChange={{fi.update}}
            @allowClear={{true}}
            @renderInPlace={{true}}
            @loadingMessage={{t "global.loadingPrompt"}}
            @searchEnabled={{false}}
            class="uk-select"
            as |reason|
          >
            {{reason.label}}
          </PowerSelect>
        </f.input>
      {{/if}}
      <f.input
        @errorComponent="input-error"
        @name="remark"
        @label={{t "deadlines.suspension.property.remark"}}
        @type="textarea"
        @rows="3"
        required
        data-test-suspension-remark-input
      />
    </modal.body>
    <modal.footer>
      <div class="uk-align-left">
        {{#unless this.isCreate}}
          <f.button
            class="uk-button-danger"
            @label={{t "global.delete"}}
            @disabled={{f.loading}}
            {{on "click" @onDelete}}
            data-test-suspension-delete
          />
        {{/unless}}
      </div>

      <div class="uk-align-right">
        <f.submit
          @label={{t "global.save"}}
          @disabled={{f.loading}}
          data-test-suspension-submit
        />
        <f.button
          @label={{t "global.cancel"}}
          @disabled={{f.loading}}
          {{on "click" @onHide}}
        />
      </div>
    </modal.footer>
  </ValidatedForm>
</UkModal>
<button
  class="uk-button uk-button-link"
  ratio="0.7"
  uk-icon=""
  type="button"
  title={{if
    (eq @type "link")
    (t "cases.miscellaneous.linkInstance")
    (t "cases.miscellaneous.unLinkInstance")
  }}
  {{on "click" this.toggle}}
>
  <FaIcon
    @icon={{if (eq @type "link") "link" "link-slash"}}
    alt={{if
      (eq @type "link")
      (t "cases.miscellaneous.linkInstance")
      (t "cases.miscellaneous.unLinkInstance")
    }}
  />
</button>
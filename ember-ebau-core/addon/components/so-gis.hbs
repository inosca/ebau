{{#unless @disabled}}
  <div class="uk-margin uk-grid uk-grid-small" data-test-search>
    <div class="uk-width-expand">
      <PowerSelect
        @selected={{this.selectedSearchResult}}
        @searchField="label"
        @placeholder={{t "gis.search.placeholder"}}
        @loadingMessage={{t "gis.search.loading"}}
        @searchEnabled={{true}}
        @searchMessage=""
        @searchPlaceholder={{t "gis.search.input-placeholder"}}
        @noMatchesMessage={{t "gis.search.empty"}}
        @onChange={{fn (mut this.selectedSearchResult)}}
        @search={{perform this.search}}
        as |result|
      >
        {{result.label}}
      </PowerSelect>
    </div>

    <div>
      <UkButton
        @color="primary"
        @disabled={{not this.selectedSearchResult}}
        @label={{t "gis.select"}}
        @onClick={{this.addSearchResultMarker}}
      />
    </div>
  </div>
{{/unless}}

<div class="map uk-margin-small-top">
  {{#unless @disabled}}
    {{#if this.showGeometrySwitch}}
      <div class="leaflet-touch">
        <div class="draw-polygon-line leaflet-touch leaflet-bar">
          <button
            class="polygon-icon {{if this.isPolygon 'is-active'}}"
            type="button"
            {{on "click" (fn this.setGeometry "POLYGON")}}
          ><FaIcon @icon="draw-polygon" @size="1x" /></button>

          <button
            type="button"
            class="line-icon {{unless this.isPolygon 'is-active'}}"
            {{on "click" (fn this.setGeometry "LINESTRING")}}
          ><FaIcon @icon="minus" @size="1x" /></button>
        </div>
      </div>
    {{/if}}
  {{/unless}}

  <div class="map-wrapper">
    <LeafletMap
      @lat={{this.center.lat}}
      @lng={{this.center.lng}}
      @zoom={{this.zoom}}
      @minZoom={{this.zoomMin}}
      @maxZoom={{this.zoomMax}}
      @onClick={{unless @disabled this.setMapPoint}}
      @onLoad={{this.initMap}}
      @crs={{this.crs}}
      class="uk-width-1-1 uk-height-large uk-margin"
      data-test-map
      as |map|
    >
      <map.tile
        @url="{{macroGetOwnConfig
          'soGisUrl'
        }}/api/wmts/1.0.0/ch.so.agi.hintergrundkarte_sw/default/2056/{z}/{y}/{x}"
      />
      <map.wms-tile
        @transparent={{true}}
        @format="image/png"
        @version="1.3.0"
        @layers="ch.so.agi.av.gebaeudeadressen.gebaeudeeingaenge,ch.so.arp.nutzungsplanung.grundnutzung"
        @url="{{macroGetOwnConfig 'soGisUrl'}}/api/wms"
      />

      {{#each this.markers as |point index|}}
        <map.marker
          @lat={{point.lat}}
          @lng={{point.lng}}
          @draggable={{not @disabled}}
          @onDragend={{fn this.updateDragged index}}
        />
      {{/each}}

      {{#if this.isPolygon}}
        <map.polygon @locations={{this.markers}} @color="red" />
      {{else if (gt this.markers.length 1)}}
        <map.polyline @locations={{this.markers}} @color="red" />
      {{/if}}
    </LeafletMap>

    {{#unless @disabled}}
      <div class="reset-button">
        {{#if this.showResetButton}}
          <UkButton @onClick={{this.resetMarkers}}><FaIcon
              @icon="rotate-left"
              @size="1x"
            />
            {{t "gis.reset"}}</UkButton>
        {{/if}}
      </div>
    {{/unless}}
  </div>
</div>

<div class="uk-grid uk-grid-small uk-child-width-1-3">
  <div>
    {{#unless @disabled}}
      <GisApplyButton
        @document={{@field.document}}
        @disabled={{not this.markers.length}}
        @params={{hash query=this.query applied="ja"}}
        @instanceId={{@context.instanceId}}
        @onApplied={{this.markApplied}}
      />
    {{/unless}}
  </div>

  <div class="uk-flex uk-flex-middle">
    {{#if this.centerCoordinate}}
      {{t "gis.centeredCoordinates"}}:
      {{format-coordinate this.centerCoordinate}}
    {{/if}}
  </div>

  <div class="uk-flex uk-flex-column uk-flex-bottom uk-flex-center">
    <SoGis::OerebPlots @plots={{this.oerebPlots}} />
  </div>
</div>
{{#if this.isDirty}}
  <div class="uk-alert-warning" uk-alert>
    <button type="button" class="uk-alert-close" uk-close></button>
    <p>{{t "gis.not-applied"}}</p>
  </div>
{{/if}}
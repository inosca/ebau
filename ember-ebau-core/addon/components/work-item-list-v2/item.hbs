<tr class={{this.rowClasses}}>
  {{#if @highlight}}
    <td class="uk-padding-remove-right {{this.highlightClasses}}"></td>
    {{#if (has-feature "workItemList.useColorForNFD")}}
      <td
        class="uk-padding-remove-right highlight
          {{if @row.hasAdditionalDemand 'highlight--nfd'}}"
      ></td>
    {{/if}}
  {{/if}}
  {{#each @columns as |column|}}
    <td class={{if (eq column "task") "uk-width-1-4"}}>
      {{#if (eq column "task")}}
        {{#if (is-legacy-app)}}
          <a href={{@row.link}}>{{@row.task}}</a>
        {{else}}
          <LinkTo @route={{@row.link.route}} @models={{@row.link.models}}>
            {{@row.task}}
          </LinkTo>
          <InstanceMarks::Icons
            @instanceMarks={{@row.instanceMarks}}
            class="uk-margin-small-left"
          />
        {{/if}}
      {{else if (eq column "description")}}
        <span
          {{uk-tooltip
            (if (gt @row.description.length 250) @row.description "")
          }}
        >
          {{truncate-text @row.description 250}}
        </span>
      {{else if (eq column "deadline")}}
        <span {{uk-tooltip (format-date @row.deadline format="date")}}>
          {{date-from-now @row.deadline}}
        </span>
      {{else if (eq column "targetDeadlineDate")}}
        {{#if @row.processDeadlineDate}}
          -
        {{else}}
          <span class={{this.targetDeadlineClasses}}>
            {{format-date @row.targetDeadlineDate format="date"}}
          </span>
        {{/if}}
      {{else if (eq column "closedAt")}}
        {{format-date @row.closedAt format="datetime"}}
      {{else}}
        {{get @row column}}
      {{/if}}
    </td>
  {{/each}}
  <td class="uk-text-right">
    <button type="button" class="uk-button uk-button-link uk-flex-inline">
      <UkIcon @icon="more-vertical" @ratio="0.8" />
    </button>
    <div uk-dropdown mode="click" pos="bottom-right">
      <ul class="uk-nav uk-dropdown-nav uk-text-normal">
        {{#if
          (or
            (can "read work-item-list-row" @row)
            (can "edit work-item-list-row" @row)
          )
        }}
          <li>
            {{#if (is-legacy-app)}}
              <a href={{@row.editLink}}>{{this.editLinkText}}</a>
            {{else}}
              <LinkTo
                @route={{@row.editLink.route}}
                @models={{@row.editLink.models}}
              >
                {{this.editLinkText}}
              </LinkTo>
            {{/if}}
          </li>
        {{/if}}
        {{#if (can "toggle read work-item-list-row" @row)}}
          <li>
            <a href="" {{on "click" this.toggleRead}}>
              {{#if @row.unread}}
                {{t "workItems.actions.markAsRead"}}
              {{else}}
                {{t "workItems.actions.markAsUnread"}}
              {{/if}}
            </a>
          </li>
        {{/if}}
        {{#if (can "assign to me work-item-list-row" @row)}}
          <li>
            <a href="" {{on "click" this.assignToMe}}>
              {{t "workItems.actions.assignToMe"}}
            </a>
          </li>
        {{/if}}
        {{#if (can "complete work-item-list-row" @row)}}
          <li>
            <a href="" {{on "click" this.quickComplete}}>
              {{t "workItems.actions.finish"}}
            </a>
          </li>
        {{/if}}
      </ul>
    </div>
  </td>
</tr>
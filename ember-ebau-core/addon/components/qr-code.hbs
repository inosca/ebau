{{#unless this.hidden}}
  <div class="uk-flex uk-flex-column uk-flex-middle">
    <div class="uk-inline">
      <img src={{this.data}} alt={{this.url}} class="uk-box-shadow-medium" />
      {{#if this.preview}}
        <div class="uk-overlay uk-overlay-default uk-position-center">
          <p
            class="uk-text-large uk-text-uppercase uk-text-bolder uk-text-danger"
          >{{t "publication.qr-code.preview"}}</p>
        </div>
      {{/if}}
    </div>
    <div class="uk-margin-top">
      <UkButton
        @color="text"
        @onClick={{perform this.download}}
        @label={{t "publication.qr-code.download"}}
      />
      <a
        class="uk-button uk-button-text uk-margin-left"
        href={{this.url}}
        target="_blank"
        rel="noopener noreferrer"
      >{{t "publication.qr-code.link"}}</a>
    </div>
  </div>
{{/unless}}
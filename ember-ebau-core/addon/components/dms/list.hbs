{{#if (or this.templates.isLoading this.users.isLoading)}}
  <div class="uk-text-center"><UkSpinner @ratio="2" /></div>
{{else}}
  {{#if (can "view dms-template" type="own")}}
    <Dms::TemplateTable @templates={{this.ownTemplates}} @type="own">
      <:before>
        <Dms::Docs
          @title={{t "dms.docs.title-admin"}}
          @showGeneralInfo={{true}}
        />
      </:before>
    </Dms::TemplateTable>
  {{/if}}

  {{#if (can "view dms-template" type="shared")}}
    <Dms::TemplateTable @templates={{this.sharedTemplates}} @type="shared">
      <:before>
        <p>
          {{t
            "dms.sharedTemplatesInfo"
            serviceGroup=this.ebauModules.serviceGroupName
            htmlSafe=true
          }}
        </p>
      </:before>
    </Dms::TemplateTable>
  {{/if}}

  {{#if
    (and this.inheritedTemplates (can "view dms-template" type="inherited"))
  }}
    <Dms::TemplateTable
      @templates={{this.inheritedTemplates}}
      @type="inherited"
    />
  {{/if}}

  {{#if (can "view dms-template" type="system")}}
    <Dms::TemplateTable @templates={{this.systemTemplates}} @type="system" />
  {{/if}}
{{/if}}
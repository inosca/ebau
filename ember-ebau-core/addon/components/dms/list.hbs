{{#if this.templates.isLoading}}
  <div class="uk-text-center"><UkSpinner @ratio="2" /></div>
{{else}}
  <div class="uk-flex uk-flex-between uk-flex-middle uk-margin-bottom">
    <h2 class="uk-margin-remove">{{t "dms.own"}}</h2>
    <LinkTo
      @route={{module-route "dms-admin" "new"}}
      class="uk-button uk-button-primary"
    >
      {{t "dms.new"}}
    </LinkTo>
  </div>

  <Dms::Docs @title={{t "dms.docs.title-admin"}} @showGeneralInfo={{true}} />

  <Dms::TemplateTable
    @templates={{this.ownTemplates}}
    @own={{true}}
    @users={{this.users}}
  />

  {{#if (can "view shared dms-template")}}
    <div class="uk-flex uk-flex-between uk-flex-middle uk-margin-bottom">
      <h2 class="uk-margin-remove">{{t "dms.sharedTemplates"}}</h2>
      {{#if (can "edit shared dms-template")}}
        <LinkTo
          @route={{module-route "dms-admin" "new"}}
          @query={{hash shared=true}}
          class="uk-button uk-button-primary"
        >
          {{t "dms.newShared"}}
        </LinkTo>
      {{/if}}
    </div>
    <p class="uk-text-default">{{t
        "dms.sharedTemplatesInfo"
        serviceGroup=this.dms.serviceGroupName
      }}</p>

    <Dms::TemplateTable
      @templates={{this.sharedTemplates}}
      @shared={{true}}
      @users={{this.users}}
    />

  {{/if}}
  {{#if this.inheritedTemplates}}
    <h2>{{t "dms.inheritedTemplates"}}</h2>
    <Dms::TemplateTable
      @templates={{this.inheritedTemplates}}
      @users={{this.users}}
    />

  {{/if}}

  <h2>{{t "dms.system"}}</h2>

  <Dms::TemplateTable @templates={{this.systemTemplates}} @system={{true}} />
{{/if}}
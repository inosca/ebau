<div
  class="uk-flex uk-flex-between uk-flex-middle uk-margin-bottom"
  ...attributes
>
  <h2 class="uk-margin-remove">{{t (concat "dms.title." @type)}}</h2>
  {{#if (can "edit dms-template" type=@type)}}
    <LinkTo
      @route={{module-route "dms-admin" "new"}}
      @query={{hash type=@type}}
      class="uk-button uk-button-primary"
    >
      {{t (concat "dms.new." @type)}}
    </LinkTo>
  {{/if}}
</div>

{{yield to="before"}}

<table class="uk-table uk-table-striped uk-table-middle">
  <thead>
    <tr>
      <th>{{t "dms.name"}}</th>
      {{#if (not-eq @type "system")}}
        <th>{{t "dms.category"}}</th>
        <th>{{t "dms.modifiedAt"}}</th>
      {{/if}}
      {{#if (eq @type "own")}}
        <th>{{t "dms.modifiedBy"}}</th>
      {{/if}}
      <th></th>
    </tr>
  </thead>
  <tbody>
    {{#each @templates as |template|}}
      <tr>
        <td>{{template.description}}</td>
        {{#if (not-eq @type "system")}}
          <td>{{or template.meta.category "-"}}</td>
          <td>
            {{if
              template.modifiedByUser
              (format-date template.modifiedAt format="datetime")
            }}
          </td>
        {{/if}}
        {{#if (eq @type "own")}}
          <td>{{or (this.getName template.modifiedByUser) "-"}}</td>
        {{/if}}
        <td class="uk-text-right">
          {{#if (can "edit dms-template" type=@type)}}
            <LinkTo
              @route={{module-route "dms-admin" "edit"}}
              @model={{template.id}}
              class="uk-button uk-button-link uk-margin-small-right"
              {{uk-tooltip (t "dms.edit") pos="left"}}
            >
              <UkIcon @icon="pencil" />
            </LinkTo>
          {{/if}}
          <button
            type="button"
            class="uk-button uk-button-link"
            {{uk-tooltip (t "dms.download") pos="left"}}
            {{on "click" (fn this.downloadTemplate.perform template)}}
          >
            <UkIcon @icon="download" />
          </button>
        </td>
      </tr>
    {{else}}
      <tr>
        <td colspan="99" class="uk-text-center uk-text-italic">
          {{t "dms.empty"}}
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>
<div class="uk-margin">
  <label class="uk-form-label uk-text-bold">
    {{t "dms.template"}}
    <span class="mandatory-asterisk">*</span>
  </label>
  <div class="uk-form-controls">
    <PowerSelect
      @options={{this.templates}}
      @selected={{this.template}}
      @onChange={{fn (mut this.template)}}
      @renderInPlace={{true}}
      @searchEnabled={{true}}
      @searchField="description"
      @noMatchesMessage={{t "global.empty"}}
      class="uk-select"
      as |template|
    >
      {{template.description}}
    </PowerSelect>
  </div>
</div>

<div class="uk-margin">
  {{#each this.documentActions as |action|}}
    <UkButton
      @color={{action.color}}
      @disabled={{or
        this.merge.isRunning
        this.placeholders.isLoading
        (not this.template)
        (cannot "merge dms-template")
      }}
      @loading={{and
        this.merge.isRunning
        (eq (get this.merge.lastRunning.args 0) action.saveToDocuments)
      }}
      @onClick={{perform this.merge action.saveToDocuments}}
    >
      {{t action.label}}
    </UkButton>
  {{/each}}
</div>

{{#if this.placeholders.isLoading}}
  <UkFlex @horizontal="center" class="uk-padding uk-animation-fade">
    <UkSpinner @ratio={{3}} />
  </UkFlex>
{{else if this.placeholders.isError}}
  <div class="uk-margin uk-flex uk-flex-center">
    <div class="uk-alert-danger uk-width-1-2 uk-padding-small">{{t
        "dms.error"
      }}</div>
  </div>
{{else}}
  <Dms::Docs
    @data={{this.placeholders.value}}
    @title={{t "dms.docs.title-generate"}}
  />
{{/if}}
<h2>
  {{#if @slug}}
    {{t "dms.edit"}}
  {{else}}
    {{t (concat "dms.new." @type)}}
  {{/if}}
</h2>

<Dms::Docs @title={{t "dms.docs.title-admin"}} @showGeneralInfo={{true}} />

{{#if this.template.isLoading}}
  <div class="uk-text-center"><UkSpinner @ratio="2" /></div>
{{else}}
  <form class="uk-form uk-form-stacked" {{on "submit" (perform this.save)}}>
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="name">
        {{t "dms.name"}}
        <span class="mandatory-asterisk">*</span>
      </label>
      <div class="uk-form-controls">
        <Input
          @type="text"
          @value={{this.template.value.description}}
          class="uk-input"
          name="name"
          id="name"
          required
        />
      </div>
    </div>
    {{#if (not-eq this.template.value.type "system")}}
      {{! System templates can't have categories }}
      <div class="uk-margin">
        <label class="uk-form-label uk-text-bold" for="category">
          {{t "dms.category"}}
        </label>
        <div class="uk-form-controls">
          <Input
            @type="text"
            @value={{this.template.value.meta.category}}
            class="uk-input"
            name="category"
            id="category"
          />
          <span class="uk-text-small uk-text-muted">{{t
              "dms.categoryHint"
            }}</span>
        </div>
      </div>
    {{/if}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold">
        {{t "dms.template"}}
        <span class="mandatory-asterisk">*</span>
      </label>
      <div class="uk-form-controls">
        {{#if this.template.value.template}}
          <span class="uk-text-italic">
            {{this.template.value.templateFileName}}
            <button
              type="button"
              class="uk-button uk-button-link"
              {{uk-tooltip (t "dms.replace")}}
              {{on "click" (fn (mut this.template.value.template) null)}}
            >
              <UkIcon @icon="pencil" />
            </button>
          </span>
        {{else}}
          <Dropzone
            @allowedMimetypes={{this.mimetypes}}
            @onValidationError={{this.onValidationError}}
            @onFileAdded={{this.setTemplate}}
          />
        {{/if}}
      </div>
    </div>
    <div class="uk-margin">
      <UkButton
        @label={{t "global.save"}}
        @color="primary"
        @type="submit"
        @loading={{this.save.isRunning}}
        @disabled={{this.save.isRunning}}
      />
      <UkButton
        @label={{t "global.back"}}
        @color="default"
        @onClick={{this.back}}
      />
      {{#if @slug}}
        <UkButton
          @label={{t "global.delete"}}
          @color="danger"
          @onClick={{this.delete.perform}}
          @disabled={{this.delete.isRunning}}
          @loading={{this.delete.isRunning}}
        />
      {{/if}}
    </div>
  </form>
{{/if}}
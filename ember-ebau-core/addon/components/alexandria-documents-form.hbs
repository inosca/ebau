<UkModal
  @visible={{this.showDuplicateModal}}
  @onHide={{fn (mut this.showDuplicateModal) false}}
  as |modal|
>
  <modal.body>
    {{t
      "documents.duplicateFileUpload"
      count=(get this.duplicateFileNames "length")
      filenames=this.formattedDuplicateFilenames
      htmlSafe=true
    }}
    {{t "documents.duplicateFileUploadGuide" htmlSafe=true}}
  </modal.body>
  <modal.footer class="uk-text-right">
    <UkButton
      @color="default"
      @label={{t "global.cancel"}}
      @onClick={{fn (mut this.showDuplicateModal) false}}
    />
  </modal.footer>
</UkModal>

{{#if (and this.disabled this.isAdditionalDemandChanges)}}
  <p class="uk-text-bold">
    {{t "documents.additional-demand-changes-not-allowed"}}
  </p>
{{/if}}

{{#if this.allRequiredTags.length}}
  <p class="uk-text-bold">
    {{t "documents.confirm" count=this.allRequiredTags.length}}
  </p>
  {{#if (t "documents.no-special-forms")}}
    <div class="uk-padding-small uk-margin-bottom border-highlight">
      {{t "documents.no-special-forms"}}
    </div>
  {{/if}}
  {{#if (t "documents.uploadPlansIndividually")}}
    <div class="uk-padding-small uk-margin-bottom border-highlight">
      {{t "documents.uploadPlansIndividually"}}
    </div>
  {{/if}}
  {{#each-in this.requiredTags as |title fields|}}
    {{#if (gt this.amountOfCategories 1)}}
      <p class="uk-margin">{{t (concat "documents.tags." title)}}</p>
    {{/if}}
    <div class="uk-margin-left">
      {{#each fields as |field|}}
        <CfField
          input
          @field={{field}}
          @disabled={{this.disabled}}
          @context={{@context}}
        />
      {{/each}}
    </div>
  {{/each-in}}

  <hr />
{{/if}}

{{#if this.allOtherFields.length}}
  {{#each this.allOtherFields as |field|}}
    <CfField
      input
      @field={{field}}
      @disabled={{this.disabled}}
      @context={{@context}}
    />
  {{/each}}
  <hr />
{{/if}}

{{#if (and (not this.categories.isLoading) this.categories.records)}}
  <div
    uk-grid
    uk-height-match
    class="uk-grid-small uk-child-width-1-1
      {{if (gt this.categories.records.length 1) 'uk-child-width-1-2@m'}}"
  >
    {{#each this.categories.records as |category|}}
      <AlexandriaDocumentBucket
        @category={{category}}
        @disabled={{this.disabled}}
        @deletable={{this.deletable}}
        @loading={{or
          this.fetchAttachments.isPending
          (and
            this.upload.isRunning
            (eq (get this.upload.lastRunning.args "0.bucket") category.id)
          )
        }}
        @attachments={{get this.attachments.value category.id}}
        @onUpload={{perform this.upload}}
        @onDelete={{perform this.delete}}
      />
    {{/each}}
  </div>
{{/if}}
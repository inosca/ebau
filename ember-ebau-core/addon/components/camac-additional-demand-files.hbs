<label class="uk-form-label uk-text-bold">{{t
    "additional-demand.documents"
  }}</label>
<div
  uk-grid={{if (gt this.buckets.length 1) "masonry: next"}}
  class="uk-grid uk-child-width-1-1
    {{if (gt this.buckets.length 1) 'uk-grid-small uk-child-width-1-2@m'}}
    print-table-container"
  {{did-insert (perform this.fetchAttachments)}}
  {{will-destroy this.teardown}}
>
  {{#each this.buckets as |bucket|}}
    <span class="print-table-row">
      <BeDocumentBucket
        @slug={{bucket}}
        @disabled={{@disabled}}
        @deletable={{not @disabled}}
        @loading={{this.fetchAttachments.isRunning}}
        @attachments={{get this.attachments bucket}}
        @useConfidential={{this.useConfidential}}
        @onUpload={{perform this.add}}
        @onDelete={{perform this.remove}}
      />
    </span>
  {{/each}}
</div>
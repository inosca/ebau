<ValidatedForm
  @model={{changeset @model this.validations}}
  @on-submit={{this.save.perform}}
  as |f|
>
  <f.input
    @name="name"
    @label={{t "sanction.property.name"}}
    @required={{true}}
  />
  <f.input
    @name="description"
    @label={{t "sanction.property.description"}}
    @type="textarea"
    {{autoresize mode="height"}}
  />
  <f.input
    @name="assignedService"
    @label={{t "sanction.property.assignedService"}}
    @required={{true}}
  >
    <PowerSelect
      @selected={{f.model.assignedService}}
      @noMatchesMessage={{t "global.noMatch"}}
      @searchEnabled={{true}}
      @searchField="name"
      @onChange={{fn (mut f.model.assignedService)}}
      @options={{this.options}}
      class="uk-select"
      as |service|
    >
      {{service.name}}
    </PowerSelect>
  </f.input>
  <f.input
    @name="controlStep"
    @label={{t "sanction.property.controlStep"}}
    @required={{true}}
    @type="radioGroup"
    @options={{this.controlSteps}}
  />

  <f.submit
    @disabled={{or f.model.isInvalid this.save.isRunning}}
    @loading={{this.save.isRunning}}
    @label={{t "global.save"}}
  />
  <UkButton @type="button" {{on "click" (fn this.cancel f.model)}}>
    {{t "global.cancel"}}
  </UkButton>
</ValidatedForm>
{{#unless @disabled}}
  <PowerSelect
    @search={{this.search.perform}}
    @searchEnabled={{true}}
    @selected={{this.searchResult.value}}
    @onChange={{this.selectSearchResult}}
    @placeholder={{t "gis.searchPlaceholder"}}
    @loadingMessage={{t "gis.loading"}}
    @searchMessage={{null}}
    @noMatchesMessage={{t "gis.noMatchesMessage"}}
    class="uk-margin"
    aria-label={{t "gis.searchPlaceholder"}}
    as |option|
  >
    {{option.label}}
  </PowerSelect>
{{/unless}}

<LeafletMap
  @lat={{this.center.lat}}
  @lng={{this.center.lng}}
  @zoom={{10}}
  @minZoom={{8}}
  @maxZoom={{20}}
  @maxBounds={{this.maxBounds}}
  @maxBoundsViscosity={{0.8}}
  @onClick={{this.selectPlot}}
  @onLoad={{this.initMap}}
  @onZoom={{this.setZoom}}
  class="uk-width-1-1 uk-border sg-gis-map"
  as |map|
>
  {{! "Bodenbedeckung" layer that is not really visible in the OEREB layer but
  is better visible in the AV collection }}
  <map.wms-tile
    @format="image/png"
    @version="1.3.0"
    @layers={{array "LCSF"}}
    @tileSize={{this.tileSize}}
    @maxZoom={{20}}
    @url="https://geodienste.ch/db/av_0"
  />
  {{! Main background map that is rendered transparent in order to show the
  "Bodenbedeckung" underneath }}
  <map.wms-tile
    @transparent={{true}}
    @format="image/png"
    @version="1.3.0"
    @layers={{array "daten"}}
    @tileSize={{this.tileSize}}
    @maxZoom={{20}}
    @url="https://geodienste.ch/db/av_situationsplan_oereb_0"
  />
  {{! Non tiled layers for labels that are otherwise cut-off in the background
  map. This loads one single image in the size of the map widget. }}
  <map.non-tiled-wms
    @transparent={{true}}
    @format="image/png"
    @version="1.3.0"
    @layers={{array "Gebaeudeadressen" "Nomenklatur" "Liegenschaften"}}
    @maxZoom={{20}}
    @url="https://geodienste.ch/db/av_situationsplan_oereb_0"
  />

  {{#if this.searchResult}}
    <map.geojson
      @geoJSON={{this.searchResult.geometry}}
      @style={{this.searchResultStyle}}
    />
  {{/if}}

  {{#each-in this.plots as |egrid plot|}}
    <map.geojson
      @geoJSON={{plot.geometry}}
      @style={{this.plotStyle}}
      @onAdd={{fn this.registerUnselectPlot egrid}}
      @onRemove={{this.unregisterUnselectPlot}}
      as |layer|
    >
      <layer.tooltip>
        {{plot.number}}
        <strong>({{egrid}})</strong>
      </layer.tooltip>
    </map.geojson>
  {{/each-in}}
</LeafletMap>

{{#unless @disabled}}
  <div class="uk-margin-top">
    <GisApplyButton
      @document={{@field.document}}
      @disabled={{not this.plots.size}}
      @params={{this.applyParams}}
      @instanceId={{@context.instanceId}}
    />
    <IconButton
      @icon="refresh"
      @onClick={{this.clear}}
      @disabled={{and (not this.plots.size) (not this.searchResult)}}
      class="uk-margin-small-left"
      {{uk-tooltip (t "gis.reset")}}
    />
  </div>
{{/unless}}
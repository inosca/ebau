{{#if (and this.showEntries this.casesQuery.value.length)}}
  <div uk-grid>
    <PaginationInfo
      @query={{this.casesQuery}}
      class="uk-text-right uk-margin-small-left uk-margin-remove-bottom"
    />
    {{#if (has-feature "cases.exportExcel")}}
      <div class="uk-width-expand uk-text-right">
        <a
          href=""
          class="uk-link-text uk-margin-small-right"
          {{on "click" (perform this.export)}}
        >
          {{#if this.export.isRunning}}
            <UkSpinner @ratio="0.5" />
          {{else}}
            <UkIcon @icon="file-text" />
          {{/if}}
          {{t "cases.export.title"}}
        </a>
      </div>
    {{/if}}
  </div>
{{/if}}

<div>
  <table class="uk-table uk-table-striped uk-table-hover">
    <thead>
      <tr>
        {{#each this.tableColumns as |tColumn|}}
          <CaseTable::Header
            @column={{tColumn}}
            @currentOrder={{@order}}
            @onSetOrder={{@onSetOrder}}
          />
        {{/each}}
      </tr>
    </thead>
    <tbody>
      {{#if this.showEntries}}
        {{#each this.casesQuery.value as |node|}}
          <CaseTable::Row @node={{node}} @tableColumns={{this.tableColumns}} />
        {{else}}
          {{#unless this.casesQuery.isLoading}}
            <tr>
              <td colspan={{this.tableColumns.length}} class="uk-text-center">
                {{t "global.empty"}}
              </td>
            </tr>
          {{/unless}}
        {{/each}}

        {{#if this.casesQuery.isLoading}}
          <tr>
            <td colspan={{this.tableColumns.length}} class="uk-text-center">
              <UkSpinner />
            </td>
          </tr>
        {{else if this.casesQuery.hasNextPage}}
          <tr
            {{in-viewport onEnter=this.casesQuery.fetchMore viewportSpy=true}}
          ></tr>
        {{/if}}
      {{else}}
        <tr>
          <td colspan={{this.tableColumns.length}} class="uk-text-center">
            {{t "cases.no-filters"}}
          </td>
        </tr>
      {{/if}}
    </tbody>
  </table>
</div>
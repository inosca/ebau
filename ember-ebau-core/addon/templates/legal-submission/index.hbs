<LegalSubmissionTable
  @types={{this.types}}
  @status={{this.status}}
  @onUpdateTypes={{fn (mut this.types)}}
  @onUpdateStatus={{fn (mut this.status)}}
/>

{{#if (t "legal-submission.hint")}}
  <div class="uk-alert uk-alert-default uk-margin-remove">
    {{t "legal-submission.hint"}}
  </div>
{{/if}}
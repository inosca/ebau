<h2>{{t "bab-statistics-export.title"}}</h2>
{{#if this.generateStatisticsExport.isRunning}}
  <UkSpinner @ratio="2" />
{{else}}
  <form class="uk-margin">
    <div class="uk-grid-small uk-width-1-2 uk-child-width-1-2" uk-grid>
      <div>
        <label class="uk-text-bold" for="from">{{t "statistics.from"}}</label>
        <Datepicker
          id="from"
          @value={{this.from}}
          @maxDate={{this.to}}
          @onChange={{fn this.setFilter "from"}}
        />
      </div>
      <div>
        <label class="uk-text-bold" for="to">{{t "statistics.to"}}</label>
        <Datepicker
          id="to"
          @value={{this.to}}
          @minDate={{this.from}}
          @onChange={{fn this.setFilter "to"}}
        />
      </div>
    </div>
  </form>
  <UkButton @onClick={{perform this.generateStatisticsExport}}>
    {{t "bab-statistics-export.generate"}}
  </UkButton>
{{/if}}
{{#if this.entryTemplates.records.length}}
  <form class="uk-form-stacked" aria-label={{t "billing.templates.select"}}>
    <label class="uk-form-label" for="entry-template">
      {{t "billing.templates.info"}}
    </label>
    <div class="uk-grid-small" uk-grid>
      <div class="uk-width-expand uk-form-controls">
        <PowerSelect
          @searchEnabled={{true}}
          @searchField="name"
          @allowClear={{true}}
          @options={{this.entryTemplates.records}}
          @selected={{this.selectedTemplate}}
          @placeholder={{t "billing.templates.select"}}
          @onChange={{fn (mut this.selectedTemplate)}}
          class="uk-select"
          data-test-templates
          as |template|
        >
          {{template.name}}
        </PowerSelect>
      </div>

      <div>
        <UkButton
          name="apply-template"
          {{on "click" this.applyTemplate}}
          @type="button"
          @label="{{t 'billing.templates.apply'}}"
          data-test-apply-template
        />
      </div>
    </div>
  </form>

  <div class="uk-margin-top uk-margin-bottom master-data-divider" />
{{/if}}

{{#if this.selectedTemplate.hint}}
  <div
    class="uk-alert uk-alert-warning multi-line-text"
    data-test-template-hint
  >{{this.selectedTemplate.hint}}</div>
{{/if}}

<form
  id="add-charge-entry-form"
  class="uk-form-horizontal"
  {{on "submit" (perform this.save)}}
>
  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold" for="text">
      {{t "billing.position"}}
      <span class="uk-text-danger">*</span>
    </label>
    <div class="uk-form-controls">
      <Input
        @type="text"
        @value={{this.newEntry.text}}
        id="text"
        name="text"
        class="uk-input"
        required
      />
    </div>
  </div>

  {{#if (has-feature "billing.remark")}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="remark">
        {{t "billing.remark"}}
      </label>
      <div class="uk-form-controls">
        <Textarea
          @value={{this.newEntry.remark}}
          id="remark"
          name="remark"
          class="uk-input"
          {{autoresize mode="height"}}
        />
      </div>
    </div>
  {{/if}}

  {{#if (has-feature "billing.legalBasis")}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="legal-basis">
        {{t "billing.legal-basis"}}
      </label>
      <div class="uk-form-controls">
        <Input
          @type="text"
          @value={{this.newEntry.legalBasis}}
          id="legal-basis"
          name="legal-basis"
          class="uk-input"
        />
      </div>
    </div>
  {{/if}}

  {{#if (has-feature "billing.costCenter")}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="cost-center">
        {{t "billing.cost-center"}}
      </label>
      <div class="uk-form-controls">
        <Input
          @type="text"
          @value={{this.newEntry.costCenter}}
          id="cost-center"
          name="cost-center"
          class="uk-input"
        />
      </div>
    </div>
  {{/if}}

  {{#if
    (and (has-feature "billing.productNumber") this.productNumbers.value.length)
  }}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="product-number">
        {{t "billing.product-number"}}
        <span class="uk-text-danger">*</span>
      </label>
      <div class="uk-form-controls">
        <select
          class="uk-select"
          name="product-number"
          id="product-number"
          required
          {{on "change" this.update}}
        >
          <option selected disabled value="">
            {{t "billing.product-number-empty"}}
          </option>
          {{#each this.productNumbers.value as |productNumber|}}
            <option value={{productNumber.number}}>
              {{productNumber.name}}
            </option>
          {{/each}}
        </select>
      </div>
    </div>
  {{/if}}

  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold" for="calculation">
      {{t "billing.calculation"}}
      <span class="uk-text-danger">*</span>
    </label>
    <div class="uk-form-controls">
      <select
        class="uk-select"
        name="calculation"
        id="calculation"
        required
        {{on "change" this.update}}
      >
        {{#each this.calculations as |calculation|}}
          <option
            value={{calculation}}
            selected={{eq this.newEntry.calculation calculation}}
          >
            {{t (concat "billing.calculations.titles." calculation)}}
          </option>
        {{/each}}
      </select>
    </div>
  </div>

  {{#if (eq this.newEntry.calculation "hourly")}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="hours">
        {{t "billing.hours"}}
        <span class="uk-text-danger">*</span>
      </label>
      <div class="uk-form-controls">
        <Input
          @type="number"
          @value={{this.newEntry.hours}}
          id="hours"
          name="hours"
          class="uk-input"
          step="0.01"
          required
        />
      </div>
    </div>

    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="hourly-rate">
        {{t "billing.hourly-rate"}}
        <span class="uk-text-danger">*</span>
      </label>
      <div class="uk-form-controls">
        <Input
          @type="number"
          @value={{this.newEntry.hourlyRate}}
          id="hourly-rate"
          name="hourly-rate"
          class="uk-input"
          step="0.01"
          required
        />
      </div>
    </div>
  {{/if}}

  {{#if (eq this.newEntry.calculation "percentage")}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="percentage">
        {{t "billing.percentage"}}
        <span class="uk-text-danger">*</span>
      </label>
      <div class="uk-form-controls">
        <Input
          @type="number"
          @value={{this.newEntry.percentage}}
          id="percentage"
          name="percentage"
          class="uk-input"
          min="0"
          max="100"
          step="0.01"
          required
        />
      </div>
    </div>
  {{/if}}

  {{#if (includes this.newEntry.calculation (array "flat" "percentage"))}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="total-cost">
        {{#if (eq this.newEntry.calculation "flat")}}
          {{t "billing.amount"}}
        {{else if (eq this.newEntry.calculation "percentage")}}
          {{t "billing.of-amount"}}
        {{/if}}
        <span class="uk-text-danger">*</span>
      </label>
      <div class="uk-form-controls">
        <div class="uk-inline uk-width-1">
          {{#if
            (and
              (has-feature "billing.applyConstructionCosts")
              (eq this.newEntry.calculation "percentage")
            )
          }}
            <a
              href=""
              class="uk-form-icon uk-form-icon-flip"
              uk-icon="pull"
              data-test-apply-construction-costs
              {{uk-tooltip (t "billing.apply-construction-costs")}}
              {{on "click" this.applyConstructionCosts.perform}}
            ><span hidden>{{t "billing.apply-construction-costs"}}</span></a>
          {{/if}}
          <Input
            @type="number"
            @value={{this.newEntry.totalCost}}
            id="total-cost"
            name="total-cost"
            class="uk-input"
            step="0.01"
            required
          />
        </div>
      </div>
    </div>
  {{/if}}

  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold" for="tax-mode">
      {{t "billing.tax-mode"}}
      <span class="uk-text-danger">*</span>
    </label>
    <div class="uk-form-controls uk-flex">
      <select
        class="uk-select"
        name="tax-mode"
        id="tax-mode"
        required
        {{on "change" this.update}}
      >
        {{#each this.taxModeOptions as |taxMode|}}
          <option
            value={{taxMode.value}}
            selected={{eq
              (concat this.newEntry.taxMode ":" this.newEntry.taxRate)
              taxMode.value
            }}
          >{{taxMode.label}}</option>
        {{/each}}
      </select>
      {{#if (has-feature "billing.billingType")}}
        <CfField::Info @text={{t "billing.tax-mode-billing-type-info"}} />
      {{/if}}
    </div>
  </div>

  {{#if (has-feature "billing.organization")}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="organization">
        {{t "billing.organization"}}
      </label>
      <div class="uk-form-controls">
        <select
          class="uk-select"
          name="organization"
          id="organization"
          {{on "change" this.update}}
        >
          <option
            value=""
            selected="{{eq this.newEntry.organization null}}"
          ></option>
          <option
            value="cantonal"
            selected="{{eq this.newEntry.organization 'cantonal'}}"
          >{{t "billing.organizations.cantonal"}}</option>
          <option
            value="municipal"
            selected="{{eq this.newEntry.organization 'municipal'}}"
          >{{t "billing.organizations.municipal"}}</option>
        </select>
      </div>
    </div>
  {{/if}}

  {{#if (has-feature "billing.billingType")}}
    <div class="uk-margin">
      <label class="uk-form-label uk-text-bold" for="organization">
        {{t "billing.billing-type"}}
        <span class="uk-text-danger">*</span>
      </label>
      <div class="uk-form-controls uk-flex">
        <select
          class="uk-select uk-width-expand"
          name="billing-type"
          id="billing-type"
          required
          {{on "change" this.update}}
        >
          {{#each this.billingTypes as |type|}}
            <option
              value={{type}}
              selected={{eq this.newEntry.billingType type}}
            >{{t (concat "billing.billing-types." type)}}</option>
          {{/each}}
        </select>
        <CfField::Info @text={{t "billing.billing-type-info"}} />
      </div>
    </div>
  {{/if}}

  <div class="uk-margin">
    <UkButton
      @type="submit"
      @color="primary"
      @loading={{this.save.isRunning}}
      @disabled={{this.save.isRunning}}
      @label={{t "global.save"}}
      data-test-submit
    />
    <LinkTo
      @route={{module-route "billing" "index"}}
      class="uk-button uk-button-default"
    >
      {{t "global.cancel"}}
    </LinkTo>
  </div>
</form>
{{maybe-translate "billing.info" htmlSafe=true}}

<BillingTable
  @entries={{this.entries}}
  @selectedRows={{this.selectedRows}}
  @onToggleAll={{this.toggleAll}}
  @onToggleRow={{this.toggleRow}}
  @onRefresh={{this.refresh}}
  @canCharge={{this.canCharge}}
  @canReleaseForClearing={{this.canReleaseForClearing}}
  @canSelect={{this.canSelect}}
  @canEdit={{this.canEdit}}
/>

{{#if this.canEdit}}
  <div class="uk-margin">
    <LinkTo
      @route={{module-route "billing" "new"}}
      class="uk-button uk-button-primary"
      data-test-add
    >
      {{t "billing.add"}}
    </LinkTo>
    {{#if this.canCharge}}
      <UkButton
        @label={{t "billing.charge"}}
        @loading={{this.charge.isRunning}}
        @disabled={{or (eq this.selectedRows.length 0) this.charge.isRunning}}
        @onClick={{perform this.charge}}
        data-test-charge-submit
      />
    {{/if}}
    {{#if this.canReleaseForClearing}}
      <UkButton
        @label={{t "billing.release-for-clearing"}}
        @loading={{this.releaseForClearing.isRunning}}
        @disabled={{or
          (eq this.selectedRows.length 0)
          this.releaseForClearing.isRunning
        }}
        @onClick={{perform this.releaseForClearing}}
        data-test-release-for-clearing-submit
      />
    {{/if}}
  </div>

  {{#if
    (and
      (await (can "invoice billing-v2-entries"))
      (gt this.notChargedEntries.value.length 0)
    )
  }}
    <div class="uk-margin">
      {{#if this.invoiceTypes.length}}
        <label for="invoice-type">{{t "billing.invoice-type"}}:</label>
        <select
          class="uk-select uk-form-width-medium uk-margin-left uk-margin-right"
          id="invoice-type"
          data-test-invoice-type
          required
          {{on "change" this.updateInvoiceType}}
        >
          <option value=""></option>
          {{#each this.invoiceTypes as |type|}}
            <option value={{type}} selected={{eq type this.invoiceType}}>
              {{type}}
            </option>
          {{/each}}
        </select>
      {{/if}}

      <UkButton
        @label={{t "billing.invoice"}}
        @loading={{this.invoice.isRunning}}
        @disabled={{this.invoice.isRunning}}
        @onClick={{perform this.invoice}}
        data-test-invoice-submit
      />
    </div>
  {{/if}}
{{/if}}
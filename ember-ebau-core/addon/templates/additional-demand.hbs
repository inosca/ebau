{{#if this.additionalDemand.isRunning}}
  <div class="uk-flex uk-flex-center">
    <UkSpinner @ratio="2" />
  </div>
{{else}}
  {{#if @model.isPaper}}
    <p>{{t "additional-demand.paper" htmlSafe=true}}</p>
  {{/if}}
  {{#if
    (or
      (and
        (has-feature "additionalDemands.showMigrated")
        this.additionalDemand.validAdditionalDemands
      )
      (not @model.isPaper)
    )
  }}
    <div uk-grid>
      {{#if this.session.isInternal}}
        <div class="uk-width-1-1">
          {{maybe-translate "additional-demand.hint" htmlSafe=true}}
        </div>
      {{/if}}
      <div class="uk-width-1-3">
        <AdditionalDemand::List @instanceId={{@model}} />
      </div>
      <div class="uk-width-expand">
        {{outlet}}
      </div>
    </div>
  {{/if}}
{{/if}}
{{#if @model.isPaper}}
  <p>{{t "additional-demand.paper" htmlSafe=true}}</p>
{{else}}
  <div uk-grid>
    {{#if this.session.isInternal}}
      <div class="uk-width-1-1">
        {{maybe-translate "additional-demand.hint" htmlSafe=true}}
      </div>
    {{/if}}
    <div class="uk-width-1-3">
      <AdditionalDemand::List @instanceId={{@model}} />
    </div>
    <div class="uk-width-expand">
      {{outlet}}
    </div>
  </div>
{{/if}}
{{#if this.responsibilities.isLoading}}
  <div class="uk-text-center">
    <UkSpinner @ratio={{2}} />
  </div>
{{else}}
  <table class="uk-table uk-table-striped uk-table-small uk-table-middle">
    <thead>
      <tr>
        <th>{{t "responsible.organisation"}}</th>
        <th>{{t "responsible.responsiblePerson"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each this.responsibilities.records as |responsibility|}}
        <tr>
          <td>{{responsibility.service.name}}</td>
          <td>{{responsibility.responsibleUser.fullName}}</td>
        </tr>
      {{else}}
        <tr>
          <td class="uk-text-center" colspan="2">
            {{t "global.empty"}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  {{#if (await (can "edit responsible-service"))}}
    <form
      {{on "submit" this.saveResponsibility.perform}}
      class="uk-form-stacked"
    >
      <label class="uk-form-label" for="responsible-user-select">
        {{t "responsible.responsible"}}
      </label>
      <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand uk-form-controls">
          <PowerSelect
            @searchEnabled={{true}}
            @searchField="fullName"
            @renderInPlace={{true}}
            @options={{this.users.records}}
            @selected={{this.selectedUser}}
            @noMatchesMessage={{t "global.noMatch"}}
            @onChange={{fn (mut this.selectedUser)}}
            class="uk-select"
            id="responsible-user-select"
            data-test-responsible-user-select
            as |user|
          >
            {{user.fullName}}
          </PowerSelect>
        </div>
        <div>
          <div class="uk-text-right uk-margin">
            <UkButton
              @disabled={{or
                (not this.selectedUser)
                this.saveResponsibility.isRunning
              }}
              @color="primary"
              @type="submit"
              @loading={{this.saveResponsibility.isRunning}}
              data-test-save-responsible
            >
              {{t "global.save"}}
            </UkButton>
          </div>
        </div>
      </div>
    </form>
  {{/if}}
{{/if}}
<form class="uk-form-stacked" {{on "submit" (perform this.save)}}>
  <div class="uk-margin">
    <label class="uk-form-label uk-text-bold" for="static-keyword">
      {{t "service-permissions.static-keyword"}}
      <span class="mandatory-asterisk">*</span>
    </label>
    <div class="uk-form-controls">
      <Input
        id="static-keyword"
        class="uk-input"
        required
        @type="text"
        @value={{this.staticKeywordName}}
      />
    </div>
  </div>
  <div class="uk-margin">
    <UkButton
      @type="submit"
      @color="primary"
      @label={{t "global.save"}}
      @loading={{this.save.isRunning}}
    />
  </div>
</form>
<div class="uk-flex uk-margin-large-top">
  <div class="uk-width-expand">
    <div class="uk-search uk-search-default uk-width-1-1">
      <span uk-search-icon></span>
      <input
        class="uk-search-input"
        type="search"
        placeholder={{t "global.search"}}
        aria-label={{t "global.search"}}
        value={{this.search}}
        {{on "input" (perform this.updateSearch)}}
      />
    </div>
  </div>
  <div class="uk-button-group uk-flex">
    <button
      class="uk-button uk-button-default
        {{if (eq this.filter 'active') 'uk-button-primary'}}"
      type="button"
      {{on "click" (fn (mut this.filter) "active")}}
    >
      {{t "service-permissions.static-keywords-active"}}
    </button>
    <button
      class="uk-button uk-button-default
        {{if (eq this.filter 'archived') 'uk-button-primary'}}"
      type="button"
      {{on "click" (fn (mut this.filter) "archived")}}
    >
      {{t "service-permissions.static-keywords-archived"}}
    </button>
    <button
      class="uk-button uk-button-default
        {{if (eq this.filter 'all') 'uk-button-primary'}}"
      type="button"
      {{on "click" (fn (mut this.filter) "all")}}
    >
      {{t "service-permissions.static-keywords-all"}}
    </button>
  </div>
</div>
<table class="uk-table uk-table-striped uk-table-middle">
  <thead>
    <tr>
      <th>{{t "service-permissions.static-keyword"}}</th>
    </tr>
  </thead>
  <tbody>
    {{#each this.staticKeywords.records as |row|}}
      <tr>
        <td>
          {{#if (eq this.editRow.id row.id)}}
            <div class="uk-flex">
              <div class="uk-form-controls uk-margin-small-right uk-width-1-1">
                <Input
                  id="static-keyword-edit"
                  class="uk-input"
                  required
                  @type="text"
                  @value={{row.name}}
                />
              </div>
              <button
                type="button"
                class="uk-button uk-button-link uk-margin-small-right"
                {{on "click" (perform this.saveEdit row)}}
              >
                <UkIcon @icon="check" />
              </button>
              <button
                type="button"
                class="uk-button uk-button-link"
                {{on "click" (fn (mut this.editRow) null)}}
              >
                <UkIcon @icon="close" />
              </button>
            </div>
          {{else}}
            <span>
              {{row.name}}
            </span>
          {{/if}}
        </td>
        <td class="uk-flex uk-flex-right">
          <button
            type="button"
            class="uk-button uk-button-link uk-margin-small-right"
            {{on "click" (fn (mut this.editRow) row)}}
          >
            <UkIcon @icon="pencil" />
          </button>
          {{#if row.instances.length}}
            {{#if row.isArchived}}
              <button
                type="button"
                class="uk-button uk-button-link"
                {{on "click" (perform this.toggleArchive row false)}}
              >
                <UkIcon @icon="eye" />
              </button>
            {{else}}
              <button
                type="button"
                class="uk-button uk-button-link"
                {{on "click" (perform this.toggleArchive row true)}}
              >
                <UkIcon @icon="eye-slash" />
              </button>
            {{/if}}

          {{else}}
            <button
              type="button"
              class="uk-button uk-button-link"
              {{on "click" (perform this.delete row)}}
            >
              <UkIcon @icon="trash" />
            </button>
          {{/if}}
        </td>
      </tr>
    {{else}}
      <tr>
        <td colspan="6" class="uk-text-center uk-text-italic">
          {{t "global.empty"}}
        </td>
      </tr>
    {{/each}}
    {{#if this.staticKeywords.isLoading}}
      <tr>
        <td colspan="6" class="uk-text-center">
          <UkSpinner @ratio="0.7" />
        </td>
      </tr>
    {{else if this.staticKeywords.hasMore}}
      <tr {{in-viewport onEnter=this.updatePage}}></tr>
    {{/if}}
  </tbody>
</table>
<CfContent
  @documentId={{this.documentId}}
  @loading={{this.publication.isRunning}}
  @disabled={{cannot "edit publication" this.publication.value}}
  @context={{hash
    instanceId=@model.instanceId
    workItemStatus=this.publication.value.status
    workItemIsPublished=this.publication.value.meta.is-published
    actionButtonOnSuccess=this.refreshNavigation
  }}
  as |content|
>
  {{#if (can "show info for publication" this.publication.value)}}
    <PublicationInfo
      @instanceId={{@model.instanceId}}
      @status={{this.publication.value.status}}
      @isPublished={{this.publication.value.meta.is-published}}
      @type={{@model.type}}
    />
  {{/if}}

  <content.form />

  <DocumentValidity @document={{content.document}} as |isValid validate|>
    {{#if
      (or
        (can "create publication" this.publication.value)
        (can "submit publication" this.publication.value)
        (can "cancel publication" this.publication.value)
        (can "delete publication" this.publication.value)
      )
    }}
      <div class="uk-flex">
        {{#if (can "create publication" this.publication.value)}}
          <TaskButton
            class="uk-margin-right"
            @color="primary"
            @task={{this.createTask}}
            @mutation="complete"
            @filters={{this.filters}}
            @onSuccess={{fn this.refreshNavigation true}}
            @label={{t (concat "publication.new." @model.type)}}
          />
        {{/if}}
        {{#if (can "submit publication" this.publication.value)}}
          <TaskButton
            class="uk-margin-right"
            @color="primary"
            @disabled={{not isValid}}
            @task={{this.fillTask}}
            @beforeMutate={{fn
              this.confirm
              (t (concat "publication.submitConfirm." @model.type))
              validate
            }}
            @mutation="complete"
            @filters={{this.filters}}
            @onSuccess={{fn this.refreshNavigation true}}
            @label={{t (concat "publication.submit." @model.type)}}
          />
        {{/if}}
        {{#if (can "cancel publication" this.publication.value)}}
          <UkButton
            @label={{t "global.cancel"}}
            @loading={{this.cancel.isRunning}}
            @disabled={{this.cancel.isRunning}}
            @onClick={{perform this.cancel}}
          />
        {{/if}}
        {{#if (can "delete publication" this.publication.value)}}
          <TaskButton
            class="uk-margin-right"
            @task={{this.fillTask}}
            @beforeMutate={{fn
              this.confirm
              (t (concat "publication.deleteConfirm." @model.type))
            }}
            @mutation="skip"
            @filters={{this.filters}}
            @onSuccess={{fn this.refreshNavigation true}}
            @label={{t (concat "publication.delete." @model.type)}}
          />
        {{/if}}
        {{#if (has-feature "publication.showPrintButton")}}
          <UkButton
            class="uk-margin-left"
            disabled={{this.placeholders.isRunning}}
            @loading={{and
              this.merge.isRunning
              (eq (get this.merge.lastRunning.args 0) true)
            }}
            @onClick={{perform this.merge true}}
          >
            {{t "dms.merge-and-save"}}
          </UkButton>
        {{/if}}
      </div>
    {{/if}}
  </DocumentValidity>
</CfContent>
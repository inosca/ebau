{{#each this.workItems as |workItem|}}
  <div class="uk-card uk-card-default uk-padding uk-margin-bottom">
    <h3 class="uk-flex uk-flex-middle uk-text-large uk-margin-remove">
      {{workItem.addressedService.name}}
    </h3>
    {{#if workItem.closedAt}}
      <div class="uk-text-muted uk-text-small uk-margin-bottom">
        {{t
          "address-assignment.sent"
          date=(format-date workItem.closedAt format="datetime")
        }}
      </div>
    {{/if}}

    <CfContent
      @documentId={{workItem.document.id}}
      @disabled={{await
        (cannot
          "complete address-assignment"
          workItem
          instanceId=this.ebauModules.instanceId
        )
      }}
      @context={{hash actionButtonOnSuccess=this.onSuccess}}
    />
  </div>
{{/each}}
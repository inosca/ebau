{{#if
  (or
    this.publications.isRunning
    this.createPublicationWorkItem.isRunning
    this.refetchPublications.isRunning
  )
}}
  <div class="uk-text-center"><UkSpinner @ratio={{2}} /></div>
{{else if this.publications.value.length}}
  <UkTab @right={{true}} as |Tab|>
    {{#each this.publications.value as |publication index|}}
      <Tab.item
        @href={{module-route
          "publication"
          "edit"
          models=(array @model.type (decode-id publication.node.id))
          asURL=true
        }}
      >
        {{t
          "publication.title"
          name=publication.node.document.form.name
          index=(add index 1)
        }}
        {{#if
          (and
            (eq publication.node.status "COMPLETED")
            publication.node.closedByUser
            (not publication.node.meta.is-published)
          )
        }}
          ({{t "publication.canceled"}})
        {{else if (eq publication.node.status "COMPLETED")}}
          {{#let (this.dateStatus publication.node.document) as |status|}}
            ({{t "publication.published"}}{{#if status}}, {{status}}{{/if}})
          {{/let}}
        {{else}}
          ({{t "publication.draft"}})
        {{/if}}
        <div class="uk-width-expand uk-text-right">
          {{this.dateRanges publication.node.document}}
        </div>
      </Tab.item>
    {{/each}}
  </UkTab>

  {{outlet}}
{{else if this.createPublicationWorkItem.value.id}}
  <TaskButton
    class="uk-margin-right"
    @color="primary"
    @task={{if
      (eq @model.type "neighbors")
      "create-information-of-neighbors"
      "create-publication"
    }}
    @mutation="complete"
    @filters={{this.filters}}
    @onSuccess={{this.refreshNavigation}}
    @label={{t (concat "publication.new." @model.type)}}
  />
{{else}}
  <p class="uk-text-italic uk-text-center">
    {{t (concat "publication.empty." @model.type)}}
  </p>
{{/if}}
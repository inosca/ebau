{{#if this.instance.isLoading}}
  <div class="uk-text-center"><UkSpinner @ratio={{2}} /></div>
{{else if this.instance.record}}
  <div class="uk-child-width-1-2" uk-grid>
    <div>
      <Corrections::Document @instance={{this.instance.record}} />
    </div>
    <div>
      <Corrections::WithdrawInstance @instance={{this.instance.record}} />
    </div>
    {{#if (has-feature "corrections.changeForm")}}
      <div>
        <Corrections::ChangeForm @instance={{this.instance.record}} />
      </div>
    {{/if}}
  </div>
{{/if}}
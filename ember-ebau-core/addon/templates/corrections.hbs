{{#if this.instance.isLoading}}
  <div class="uk-text-center"><UkSpinner @ratio={{2}} /></div>
{{else if this.instance.record}}
  <div class="uk-child-width-1-2" uk-grid>
    {{#if
      (and
        (has-feature "corrections.correctForm") (not this.isMunicipalityLight)
      )
    }}
      <div>
        <Corrections::Document @instance={{this.instance.record}} />
      </div>
    {{/if}}
    {{#if (has-feature "corrections.withdrawInstance")}}
      <div>
        <Corrections::WithdrawInstance @instance={{this.instance.record}} />
      </div>
    {{/if}}
    {{#if
      (and
        (has-feature "corrections.changeForm") (not this.isMunicipalityLight)
      )
    }}
      <div>
        <Corrections::ChangeForm @instance={{this.instance.record}} />
      </div>
    {{/if}}
    {{#if (has-feature "corrections.changeDossierNumber")}}
      <div>
        <Corrections::ChangeDossierNumber @instance={{this.instance.record}} />
      </div>
    {{/if}}
    {{#if
      (and
        (has-feature "corrections.convertModification")
        this.instance.record.isModification
        (not this.isAppeal.value)
      )
    }}
      <div>
        <Corrections::ConvertModification @instance={{this.instance.record}} />
      </div>
    {{/if}}
    {{#if (has-feature "corrections.archiveInstance")}}
      <div>
        <Corrections::ArchiveInstance @instance={{this.instance.record}} />
      </div>
    {{/if}}
    {{#if (has-feature "corrections.copyInstance")}}
      <div>
        <Corrections::CopyInstance @instance={{this.instance.record}} />
      </div>
    {{/if}}
    {{#if
      (and
        (has-feature "corrections.deleteInternalInstance")
        (can "delete instance" this.instance.record)
      )
    }}
      <div>
        <Corrections::DeleteInstance @instance={{this.instance.record}} />
      </div>
    {{/if}}
  </div>
{{/if}}
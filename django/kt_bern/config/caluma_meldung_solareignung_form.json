  {
    "model": "caluma_form.question",
    "pk": "hinweis-meldung-solareignung",
    "fields": {
      "created_at": "2025-11-28T09:47:10.031Z",
      "modified_at": "2025-11-28T10:00:21.273Z",
      "created_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "created_by_group": null,
      "modified_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "modified_by_group": null,
      "label": "{\"de\": \"Hinweis Meldung Solareignung\", \"fr\": null, \"it\": null}",
      "type": "static",
      "is_required": "false",
      "is_hidden": "false",
      "is_archived": false,
      "placeholder": "{\"de\": null, \"fr\": null, \"it\": null}",
      "info_text": "{\"de\": \"\", \"fr\": null, \"it\": null}",
      "hint_text": "{\"de\": null, \"fr\": null, \"it\": null}",
      "static_content": "{\"de\": \"Bei umfassenden Erneuerungen von Dachflächen von bestehenden, auf Dauer angelegten Bauten gilt nach Art. 39d des Kantonalen Energiegesetzes eine Meldepflicht. Die Meldung muss Auskunft über die Eignung der Dachflächen für die Solarenergienutzung, das solare Potenzial und die Solarausstattungskosten geben. Massgebend sind die einzelnen Dachflächen und nicht die Gesamtsumme aller Dächer einer Baute.\\n\\nDachflächen, die kleiner als 20 m2 sind von der Meldepflicht befreit.\\n\\n\\nBei baubewilligungspflichtigen Vorhaben, bei denen kein Einbau einer Solaranlage vorgesehen ist, muss die Meldung spätestens zusammen mit dem Baugesuch eingereicht werden. Wird im Rahmen einer baubewilligungspflichtigen Dachsanierung eine Solaranlage installiert, ist die Einreichung einer zusätzlichen Meldung nicht erforderlich. Die Meldepflicht wird in diesen Fällen durch die Einreichung des Baugesuchs erfüllt.\\n\\n\\nDie Meldung muss eine Eignungsanalyse pro Dachfläche enthalten, die den prognostizierten jährlichen Energieertrag für die Solarenergienutzung (Solarthermie und / oder Photovoltaik) und die geschätzten Solarausstattungskosten ausweist. Unter Solarausstattungskosten sind die Bruttoinvestitionen für eine Solaranlage zu verstehen (bspw.: Planung, Material, Installation, sowie Anmeldung und Inbetriebnahme der Anlage). Die Analyse erfolgt mit dem Solarrechner des Bundesamtes für Energie (BFE; [www.sonnendach.ch](https://sonnendach.ch)).\", \"fr\": \"\", \"it\": \"\"}",
      "configuration": {},
      "meta": {},
      "data_source": null,
      "row_form": null,
      "sub_form": null,
      "source": null,
      "format_validators": "[]",
      "default_answer": null,
      "calc_expression": null,
      "calc_dependents": "[]"
    }
  },

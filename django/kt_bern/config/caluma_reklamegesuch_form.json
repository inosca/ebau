  {
    "model": "caluma_form.option",
    "pk": "reklamegesuch-anforderungen-eingehalten-ja",
    "fields": {
      "created_at": "2024-07-19T11:47:36.237Z",
      "modified_at": "2024-07-19T11:48:06.822Z",
      "created_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "created_by_group": null,
      "modified_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "modified_by_group": null,
      "label": "{\"de\": \"Die Anforderungen sind gemäss Art. 11 – 15 BewD eingehalten.\", \"fr\": \"Les exigences énoncées aux articles 11 à 15 DPC sont respectées.\", \"it\": null}",
      "is_hidden": "false",
      "is_archived": false,
      "meta": {},
      "source": null
    }
  },
  {
    "model": "caluma_form.option",
    "pk": "reklamegesuch-bestaetigung-berechtigung-bauherrschaft-ja",
    "fields": {
      "created_at": "2024-07-19T11:53:35.166Z",
      "modified_at": "2024-07-19T11:53:56.396Z",
      "created_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "created_by_group": null,
      "modified_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "modified_by_group": null,
      "label": "{\"de\": \"Die gesuchstellende Person bestätigt, dass sie die Berechtigung auf das eBau Dossier hat. Sofern das Baugesuch nicht durch die gesuchstellende Person selbst, sondern durch eine Drittperson (z.B. Vertretung, Architekt(in), Projektverfasser(in) etc.) in eBau erfasst wurde, bestätigt diese Drittperson, welche das Baugesuch ausgefüllt hat, dass sie der gesuchstellenden Person bzw. der Bauherrschaft die Berechtigung (via Tab «Berechtigungen») auf das eBau Dossier erteilt hat.\", \"fr\": \"La personne requérante confirme qu'elle a le droit d'accéder au dossier eBau. Dans la mesure où la demande de permis de construire n'a pas été saisie dans eBau par la personne requérante elle-même, mais par une personne tierce (p. ex. représentant(e), architecte, auteur(e) de projet, etc.), cette personne tierce ayant rempli la demande de permis de construire confirme qu'elle a accordé à la personne requérante ou au maître d'ouvrage le droit (via l'onglet « Autorisation ») d'accéder au dossier eBau.\", \"it\": null}",
      "is_hidden": "false",
      "is_archived": false,
      "meta": {},
      "source": null
    }
  },
  {
    "model": "caluma_form.option",
    "pk": "reklamegesuch-bestaetigung-gis-ja",
    "fields": {
      "created_at": "2024-07-19T11:52:09.694Z",
      "modified_at": "2024-07-19T11:52:27.510Z",
      "created_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "created_by_group": null,
      "modified_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "modified_by_group": null,
      "label": "{\"de\": \"Der/die Gesuchsteller/in bestätigt, dass die vom GIS-System übernommen Daten mit den baurechtlichen Grundlagen übereinstimmen.\", \"fr\": \"Le/la requérant/e confirme que les données reprises du SIG sont conformes à la réglementation fondamentale en matière de construction.\", \"it\": null}",
      "is_hidden": "false",
      "is_archived": false,
      "meta": {},
      "source": null
    }
  },
  {
    "model": "caluma_form.option",
    "pk": "reklamegesuch-bestaetigung-mit-unterschrift-ja",
    "fields": {
      "created_at": "2024-07-19T11:49:21.701Z",
      "modified_at": "2024-07-19T11:49:54.610Z",
      "created_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "created_by_group": null,
      "modified_by_user": "855a5ba0-cdcc-48d5-ab7c-4fc55cbe0754",
      "modified_by_group": null,
      "label": "{\"de\": \"Der/die Gesuchsteller/in resp. die bevollmächtigte Vertretung bestätigt mit rechtsgültiger Unterschrift, dass die elektronisch übermittelten Daten (inkl. dem unterzeichneten Situationsplan) vollständig und wahrheitsgetreu ausgefüllt und eingereicht worden sind.\", \"fr\": \"Le maître d'ouvrage ou son/sa représentant/e dûment mandaté/e confirme par sa signature légalement valable que les données transmises par la voie électronique (y c. le plan de situation signé) sont complètes et conformes à la vérité.\", \"it\": null}",
      "is_hidden": "false",
      "is_archived": false,
      "meta": {},
      "source": null
    }
  },

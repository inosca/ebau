{
  "openapi": "3.1.0",
  "info": {
    "title": "EBP Migration API",
    "description": "EBP Migration API",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "http://prism-mock:4010/prod/api/v1"
    }
  ],
  "paths": {
    "/infrastructure/initialize": {
      "post": {
        "tags": ["Infrastructure check and setup"],
        "summary": "checks setup of the migration e.g. AppDB tables, S3 bucket, etc. and create these if missing.",
        "operationId": "check_env_infrastructure_initialize_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfrastructureCheck"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/data/erp/replicate": {
      "post": {
        "tags": ["Document Data SAP ERP/DVS"],
        "summary": "replicate ERP/DVS documents based on filters",
        "operationId": "document_data_copy_data_erp_replicate_post",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "purge",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "purge existing documents of all found requests before copying.",
              "default": false,
              "title": "Purge"
            },
            "description": "purge existing documents of all found requests before copying."
          },
          {
            "name": "communeId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "maximum": 9999,
                "minimum": 1000
              },
              "description": "commune ids to filter e.g. 4001 for Aarau",
              "default": [],
              "title": "Communeid"
            },
            "description": "commune ids to filter e.g. 4001 for Aarau"
          },
          {
            "name": "requestId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "full request identifier e.g. EEPO-1984-2322",
              "default": [],
              "title": "Requestid"
            },
            "description": "full request identifier e.g. EEPO-1984-2322"
          },
          {
            "name": "status_commune",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/routes__document__StatusOptions__1"
              },
              "default": [],
              "title": "Status Commune"
            }
          },
          {
            "name": "status_canton",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/routes__document__StatusOptions__2"
              },
              "default": [],
              "title": "Status Canton"
            }
          },
          {
            "name": "submissionDateFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "e.g. 2021-01-01",
              "title": "Submissiondatefrom"
            },
            "description": "e.g. 2021-01-01"
          },
          {
            "name": "submissionDateTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "e.g. 2021-12-31",
              "title": "Submissiondateto"
            },
            "description": "e.g. 2021-12-31"
          },
          {
            "name": "cancelLastRun",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "cancel last running replication, if any",
              "default": false,
              "title": "Cancellastrun"
            },
            "description": "cancel last running replication, if any"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplicationMessage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/data/erp/checkReplication": {
      "get": {
        "tags": ["Document Data SAP ERP/DVS"],
        "summary": "ERP/DVS replication status",
        "operationId": "info_request_status_data_erp_checkReplication_get",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReplicationStatus"
            }
          },
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Verbose"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DmsReplication"
                  },
                  "title": "Response Info Request Status Data Erp Checkreplication Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/data/erp/downloadReplicationCsv": {
      "get": {
        "tags": ["Document Data SAP ERP/DVS"],
        "summary": "ERP/DVS replication csv file transfer log",
        "operationId": "download_csv_data_erp_downloadReplicationCsv_get",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppdbCheck": {
        "properties": {
          "table_created": {
            "type": "boolean",
            "title": "Table Created",
            "default": false
          }
        },
        "type": "object",
        "title": "AppdbCheck"
      },
      "DmsReplication": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": ""
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": ""
          },
          "requests_ebp_erp": {
            "type": "integer",
            "title": "Requests Ebp Erp",
            "default": 0
          },
          "requests_diba_s3": {
            "type": "integer",
            "title": "Requests Diba S3",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "processing_time": {
            "type": "string",
            "title": "Processing Time",
            "default": ""
          },
          "requests": {
            "items": {
              "$ref": "#/components/schemas/DmsRequestLog"
            },
            "type": "array",
            "title": "Requests",
            "default": []
          },
          "input": {
            "title": "Input"
          }
        },
        "type": "object",
        "title": "DmsReplication"
      },
      "DmsRequestLog": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "default": ""
          },
          "commune_id": {
            "type": "string",
            "title": "Commune Id",
            "default": ""
          },
          "docs_ebp_erp": {
            "type": "integer",
            "title": "Docs Ebp Erp",
            "default": 0
          },
          "docs_diba_s3": {
            "type": "integer",
            "title": "Docs Diba S3",
            "default": 0
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": ""
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "processing_time": {
            "type": "string",
            "title": "Processing Time",
            "default": ""
          }
        },
        "type": "object",
        "title": "DmsRequestLog"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InfrastructureCheck": {
        "properties": {
          "s3": {
            "$ref": "#/components/schemas/S3Check",
            "default": {
              "bucket_exists": false,
              "bucket_created": false
            }
          },
          "appdb": {
            "$ref": "#/components/schemas/AppdbCheck",
            "default": {
              "table_created": false
            }
          }
        },
        "type": "object",
        "title": "InfrastructureCheck"
      },
      "ReplicationMessage": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "replication_id": {
            "type": "string",
            "title": "Replication Id"
          }
        },
        "type": "object",
        "required": ["code", "status", "message", "replication_id"],
        "title": "ReplicationMessage"
      },
      "ReplicationStatus": {
        "type": "string",
        "enum": ["running", "completed", "failed", "cancelled", "error"],
        "title": "ReplicationStatus"
      },
      "S3Check": {
        "properties": {
          "bucket_exists": {
            "type": "boolean",
            "title": "Bucket Exists",
            "default": false
          },
          "bucket_created": {
            "type": "boolean",
            "title": "Bucket Created",
            "default": false
          }
        },
        "type": "object",
        "title": "S3Check"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "routes__document__StatusOptions__1": {
        "type": "string",
        "enum": [
          "Gesuch in Erfassung",
          "Gesuch übermittelt",
          "Gesuch storniert",
          "Gesuch in Bearbeitung",
          "Anfrage / Stellungnahme offen",
          "In öffentlicher Auflage",
          "Verfügung erstellt",
          "Gesuch zurückgezogen",
          "Gesuch abgeschrieben",
          "Gesuch archiviert",
          "Gesuch Offline erfasst",
          "Rückbau bestätigt",
          "An Kanton gesendet"
        ],
        "title": "StatusOptions"
      },
      "routes__document__StatusOptions__2": {
        "type": "string",
        "enum": [
          "Neues Gesuch",
          "Zurückgewiesen",
          "Sistiert",
          "Weiterbearbeitung AfB",
          "Freigabeverfahren",
          "Fachstelle Aufgabe offen",
          "Vorläufiger Abschluss",
          "Definitiver Abschluss"
        ],
        "title": "StatusOptions"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}

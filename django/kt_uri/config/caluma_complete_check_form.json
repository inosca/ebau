  {
    "model": "caluma_form.question",
    "pk": "complete-check-baubewilligungspflichtig",
    "fields": {
      "created_at": "2023-12-08T09:59:09.968Z",
      "modified_at": "2025-03-14T05:41:42.675Z",
      "created_by_user": "admin",
      "created_by_group": null,
      "modified_by_user": "admin",
      "modified_by_group": null,
      "label": "{\"de\": \"Baubewilligungsverfahren durchführen?\", \"fr\": null, \"it\": null}",
      "type": "choice",
      "is_required": "true",
      "is_hidden": "info.case.form in [\"cantonal-territory-usage\", \"konzession-waermeentnahme\", \"bohrbewilligung-waermeentnahme\", \"pgv-gemeindestrasse\", \"bgbb\", \"oereb\", \"oereb-verfahren-gemeinde\", \"verfahren-gemeinde\", \"mitbericht-kanton\"]",
      "is_archived": false,
      "placeholder": "{\"de\": null, \"fr\": null, \"it\": null}",
      "info_text": "{\"de\": \"## Baubewilligungsverfahren durchführen / Dossier umwandeln in ein Baugesuch\\n\\nDie Auswahl \\\"\\\"ja\\\"\\\", wandelt die Verfahren, Baugesuch-Vorabklärung, Reklamegesuch, Solaranlage und Gebäudetechnik automatisch in ein Baubewilligungsverfahren um. Diese können dann gleich wie das ordentliche Baubewilligungsverfahren publiziert und weiter bearbeitet werden.\\n\\nBeim Verfahren «Baumeldung für geringfügige Vorhaben» ist die Umwandlung in ein Baugesuch nicht möglich. Wenn bei einer Baumeldung festgestellt wird, dass ein Baubewilligungsverfahren notwendig ist, muss dieses via URec im Rahmen der Vollständigkeitsprüfung an die Bauherrschaft zurückgeschickt und die Eingabe eines Baugesuches verlangt werden. Das Formular «Baumeldung für geringfügige Vorhaben» beinhaltet nur wenige Angaben und ist für ein Baubewilligungsverfahren nicht geeignet.\", \"fr\": null, \"it\": null}",
      "hint_text": "{\"de\": \"\", \"fr\": null, \"it\": null}",
      "static_content": "{\"de\": \"\", \"fr\": \"\", \"it\": \"\"}",
      "configuration": {},
      "meta": {},

  {
    "model": "caluma_form.question",
    "pk": "complete-check-vollstaendigkeitspruefung",
    "fields": {
      "created_at": "2023-12-08T09:58:18.628Z",
      "modified_at": "2025-03-14T05:43:06.236Z",
      "created_by_user": "admin",
      "created_by_group": null,
      "modified_by_user": "admin",
      "modified_by_group": null,
      "label": "{\"de\": \"Resultat der Vollständigkeitsprüfung\", \"fr\": null, \"it\": null}",
      "type": "choice",
      "is_required": "true",
      "is_hidden": "false",
      "is_archived": false,
      "placeholder": "{\"de\": null, \"fr\": null, \"it\": null}",
      "info_text": "{\"de\": \"## GWR Aufgaben\\n\\nWenn ein Dossier im Formular Vollständigkeitsprüfung als vollständig angenommen wird oder wenn die Auswahl \\\"Nachforderung, weiter zur materiellen Prüfung\\\" ausgewählt wird, generiert URec für die Bauverwaltung nebst den Aufgaben «Freigeben für Baukommission» und «Zirkulation starten», auch die Aufgabe \\\"GWR Relevanz prüfen\\\". Die Aufgabe wird im Menu «Dossierbezogene Aufgaben» angezeigt. Entsprechend der Auswahl im Formular GWR Relevanz prüfen (ja oder nein) werden dann die folgenden GWR Aufgaben automatisch und entsprechend dem Prozessablauf angezeigt.\\n\\nWenn die Auswahl \\\"Nachforderung, auf Antwort warten\\\" gewählt wird, wird die Aufgabe \\\"\\\"GWR Relevanz prüfen\\\", erst generiert, wenn die Nachforderung von der Bauverwaltung abgeschlossen wird (der Gesuchsteller schickt die nachgeforderten Unterlagen via URec, die Bauverwaltung schliesst die Nachforderung ab, Nachforderung vollständig).\\n\\nWenn die Auswahl \\\"Dossier zurückweisen\\\" angeklickt wird, werden keine GWR Aufgaben generiert.\\n\\n## Dossier zurückweisen\\n\\nWenn ein Dossier zurückgewiesen wird, öffnet sich ein neues Textfeld. Bitte geben Sie hier den Grund der Rückweisung an und klicken Sie auf abschliessen. Der Gesuchsteller erhält eine Mail dass sein Dossier zurückgewiesen wurde und kann den Grund der Rückweisung auf dem Portal anschauen. Ein zurückgewiesenes Dossier kann vom Gesuchsteller wieder neu eingereicht werden. Es wird eine neue Dossiernummer generiert und der Prozess beginnt von vorne.\", \"fr\": null, \"it\": null}",
      "hint_text": "{\"de\": \"\", \"fr\": null, \"it\": null}",
      "static_content": "{\"de\": \"\", \"fr\": \"\", \"it\": \"\"}",
